---
import '../styles/global.css'
import '../styles/components.css'
import Header from '../components/global/Header.astro'
import Footer from '../components/global/Footer.astro'
import SearchModal from '../components/global/SearchModal.astro'
import FeedbackFab from '../components/global/FeedbackFab.astro'
import AnnouncementBanner from '../components/global/AnnouncementBanner.astro'
import type { Lang } from '../data/i18n'
import { t } from '../data/i18n'
import { guideNode, personNode, websiteNode, WEBSITE_ID } from '../data/site-schema'

interface Props {
  lang: Lang
  title?: string
  description?: string
  ogDescription?: string
  twitterDescription?: string
  image?: string
  ogType?: string
  noIndex?: boolean
  preloadImages?: string[]
  jsonLd?: Record<string, any>[]
}

const {
  lang,
  title,
  description,
  ogDescription,
  twitterDescription,
  image = '/og-image.png',
  ogType = 'website',
  noIndex = false,
  preloadImages = [],
  jsonLd,
} = Astro.props

const strings = t(lang)
const pageTitle = title || strings.siteTitle
const pageDescription = description || strings.siteDescription
const pageOgDescription = ogDescription || pageDescription
const pageTwitterDescription = twitterDescription || pageDescription
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImageURL = new URL(image, Astro.site)
const gaId = 'G-WH1C8CM79E'
const altLang = lang === 'en' ? 'fr' : 'en'
const altUrl = lang === 'en'
  ? new URL('/fr' + Astro.url.pathname, Astro.site)
  : new URL(Astro.url.pathname.replace(/^\/fr/, '') || '/', Astro.site)

// Breadcrumb: Home, then the language root on /fr/, then the current page.
const languageRoot = lang === 'fr' ? new URL('/fr/', Astro.site) : new URL('/', Astro.site)
const breadcrumb = [
  { name: 'Home', item: String(Astro.site) },
  ...(lang === 'fr' ? [{ name: 'Français', item: String(languageRoot) }] : []),
  ...(canonicalURL.pathname !== languageRoot.pathname
    ? [{ name: pageTitle.split(' | ')[0], item: canonicalURL.href }]
    : []),
]

// speakable: keep only the selectors that exist in this page. Not every landing
// page has a hero or a FAQ section, and a selector that matches nothing is noise.
const renderedBody = await Astro.slots.render('default')
const hasClass = (name: string) => new RegExp(`class="[^"]*\\b${name}\\b`).test(renderedBody)
const hasFaq = /\bid="faq"/.test(renderedBody)
const speakableSelectors = [
  /<h1\b/.test(renderedBody) && 'h1',
  hasClass('hero-tagline') && '.hero-tagline',
  hasClass('hero-stats') && '.hero-stats',
  hasFaq && /<h2\b/.test(renderedBody) && '#faq h2',
  hasFaq && hasClass('faq-item') && /<summary\b/.test(renderedBody) && '#faq .faq-item summary',
  hasFaq && hasClass('faq-item') && '#faq .faq-item p',
].filter((selector): selector is string => Boolean(selector))
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />

    {preloadImages.map((src) => (
      <link rel="preload" href={src} as="image" />
    ))}

    <!-- Hreflang -->
    <link rel="alternate" hreflang={lang} href={canonicalURL} />
    <link rel="alternate" hreflang={altLang} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={lang === 'en' ? canonicalURL : altUrl} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Florian BRUNIAUX" />
    <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageOgDescription} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Claude Cowork Guide" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_US' : 'fr_FR'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageTwitterDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preconnect (only hosts actually fetched at runtime: the shields.io
         badges are rendered in CSS now, so preconnecting there cost a DNS +
         TLS handshake to a host that was never contacted). -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />

    <!-- Anti-FOUC: dark mode default -->
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('theme');
        var theme = stored || 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <!-- JSON-LD: #website, #person and #guide come from src/data/site-schema.ts so that
         every template defines them identically; only the page-level nodes vary. -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        websiteNode,
        personNode,
        guideNode,
        {
          // No @id on purpose: the FAQ and releases pages pass their own WebPage node
          // (with an @id) through the jsonLd prop, and two definitions of one @id would conflict.
          "@type": "WebPage",
          url: canonicalURL.href,
          name: pageTitle,
          inLanguage: lang,
          isPartOf: { "@id": WEBSITE_ID },
          ...(speakableSelectors.length > 0 && {
            speakable: { "@type": "SpeakableSpecification", cssSelector: speakableSelectors },
          }),
        },
        {
          "@type": "BreadcrumbList",
          itemListElement: breadcrumb.map(({ name, item }, index) => ({ "@type": "ListItem", position: index + 1, name, item })),
        },
      ],
    })} />

    <!-- Additional JSON-LD (per-page schema) -->
    {jsonLd && jsonLd.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...schema })} />
    ))}

    <!-- Google Analytics 4 -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">
      {strings.skipToContent}
    </a>

    <!-- Scroll Progress -->
    <div class="scroll-progress" aria-hidden="true"></div>

    <Header lang={lang} />
    <AnnouncementBanner lang={lang} />
    <main id="main-content" class="pt-14">
      <slot />
    </main>
    <Footer lang={lang} />
    <SearchModal lang={lang} />

    <FeedbackFab />

    <!-- Client scripts -->
    <script>
      // Scroll progress bar
      window.addEventListener('scroll', () => {
        const scrollProgress = document.querySelector('.scroll-progress') as HTMLElement
        if (!scrollProgress) return
        const scrollTop = window.scrollY
        const docHeight = document.documentElement.scrollHeight - window.innerHeight
        const scrollPercent = (scrollTop / docHeight) * 100
        scrollProgress.style.width = scrollPercent + '%'
      })

      // Section fade-in on scroll
      document.body.classList.add('js-loaded')
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible')
          }
        })
      }, { threshold: 0.1 })

      document.querySelectorAll('.section').forEach(section => {
        observer.observe(section)
      })
    </script>
  </body>
</html>
