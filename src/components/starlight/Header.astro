---
/**
 * Starlight Header override.
 * Renders the site-wide header and search modal.
 * This replaces Starlight's default header entirely.
 */
import GlobalHeader from '../global/Header.astro'
import SearchModal from '../global/SearchModal.astro'
const lang = Astro.url.pathname.startsWith('/fr/') ? 'fr' : 'en'
---
<GlobalHeader lang={lang} />
<SearchModal lang={lang} />
