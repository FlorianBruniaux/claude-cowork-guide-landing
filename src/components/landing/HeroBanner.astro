---
import type { Lang } from '../../data/i18n'
import { t } from '../../data/i18n'

interface Props { lang: Lang }
const { lang } = Astro.props
const s = t(lang)

const ghUrl = 'https://github.com/FlorianBruniaux/claude-cowork-guide'
const isEn = lang === 'en'
---

<section class="hero band band-ink band-hero section-wallpaper">
  <div class="container hero-content">
    <h1 class="hero-title">{s.heroTitle}</h1>
    <p class="hero-tagline">{s.heroTagline}</p>

    <div class="hero-badges">
      <a href={ghUrl} target="_blank" rel="noopener" class="badge badge-stars">
        <span class="badge-label">★ stars</span>
        <span class="badge-value" id="hero-stars">—</span>
      </a>
      <a href={isEn ? '/workflows/' : '/fr/workflows/'} class="badge badge-workflows">
        <span class="badge-label">{s.heroBadgeLabelWorkflows}</span>
        <span class="badge-value">{s.heroBadgeWorkflows}</span>
      </a>
      <a href={isEn ? '/prompts/' : '/fr/prompts/'} class="badge badge-prompts">
        <span class="badge-label">{s.heroBadgeLabelPrompts}</span>
        <span class="badge-value">{s.heroBadgePrompts}</span>
      </a>
      <span class="badge badge-rules">
        <span class="badge-label">{s.heroBadgeLabelRules}</span>
        <span class="badge-value">{s.heroBadgeRules}</span>
      </span>
      <a href={ghUrl} target="_blank" rel="noopener" class="badge badge-opensource">
        <span class="badge-label">license</span>
        <span class="badge-value">CC BY-SA 4.0</span>
      </a>
    </div>

    <div class="hero-ctas">
      <a href="/guide/" class="btn btn-primary" data-astro-prefetch="false">{s.heroCta}</a>
      <a href={isEn ? '/workflows/' : '/fr/workflows/'} class="btn btn-secondary">{s.heroCtaSecondary}</a>
    </div>

    <nav class="hero-quick-nav" aria-label={isEn ? 'Quick navigation' : 'Navigation rapide'}>
      <span class="quick-nav-label">{isEn ? 'Already know what you need?' : 'Déjà savoir ce qu\'il vous faut ?'}</span>
      <a href={isEn ? '/workflows/' : '/fr/workflows/'}>29 Workflows</a>
      <span class="quick-nav-sep" aria-hidden="true">|</span>
      <a href={isEn ? '/prompts/' : '/fr/prompts/'}>{isEn ? '70 Prompts' : '70 Prompts'}</a>
      <span class="quick-nav-sep" aria-hidden="true">|</span>
      <a href={isEn ? '/glossary/' : '/fr/glossary/'}>{isEn ? 'Glossary' : 'Glossaire'}</a>
      <span class="quick-nav-sep" aria-hidden="true">|</span>
      <a href={isEn ? '/faq/' : '/fr/faq/'}>FAQ</a>
    </nav>
  </div>
</section>

<script>
  async function loadStars() {
    try {
      const res = await fetch('https://api.github.com/repos/FlorianBruniaux/claude-cowork-guide')
      if (res.ok) {
        const data = await res.json()
        const stars = data.stargazers_count as number
        const el = document.getElementById('hero-stars')
        if (el && stars) {
          el.textContent = stars >= 1000
            ? (stars / 1000).toFixed(1).replace(/\.0$/, '') + 'k'
            : String(stars)
        }
      }
    } catch {
      const el = document.getElementById('hero-stars')
      if (el) el.textContent = '★'
    }
  }
  // Defer the GitHub API call until the page is idle so it stays off the critical path.
  const schedule = () =>
    'requestIdleCallback' in window ? requestIdleCallback(() => loadStars()) : setTimeout(loadStars, 1)
  if (document.readyState === 'complete') schedule()
  else window.addEventListener('load', schedule, { once: true })
</script>

<style>
  .hero {
    padding: clamp(3.5rem, 7vw, 5.5rem) 0 clamp(3rem, 6vw, 4.5rem);
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1;
    margin-bottom: var(--space-md);
    color: var(--text-primary);
  }

  .hero-tagline {
    max-width: 44rem;
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-xl);
  }

  /* Badges: flat chips readable on charcoal, no lift on hover. */
  .hero-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: var(--space-xl);
  }

  .badge {
    display: inline-flex;
    align-items: stretch;
    min-height: 32px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    overflow: hidden;
    text-decoration: none !important;
    transition: border-color 150ms ease;
    cursor: default;
  }
  a.badge { cursor: pointer; }
  a.badge:hover { border-color: var(--accent); }

  .badge-label,
  .badge-value {
    padding: 0 0.6rem;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  .badge-label {
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .badge-value {
    background: var(--surface-elevated);
    color: var(--text-primary);
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-lg);
  }

  .hero-quick-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .quick-nav-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .hero-quick-nav a {
    font-size: 0.8rem;
    color: var(--accent);
    text-decoration: none;
  }
  .hero-quick-nav a:hover,
  .hero-quick-nav a:focus-visible {
    text-decoration: underline;
  }
  .quick-nav-sep {
    color: var(--border);
    font-size: 0.75rem;
  }

  @media (max-width: 768px) {
    .hero { padding: 2.75rem 0 2rem; }
    .hero-title { font-size: clamp(2.2rem, 11vw, 3rem); }
    .hero-tagline { font-size: 1.1rem; }
    .hero-ctas .btn { flex: 1 1 100%; }
  }
</style>
