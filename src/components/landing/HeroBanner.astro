---
import type { Lang } from '../../data/i18n'
import { t } from '../../data/i18n'

interface Props { lang: Lang }
const s = t(Astro.props.lang)
---

<section class="hero">
  <div class="container hero-content">
    <h1 class="hero-title">{s.heroTitle}</h1>
    <p class="hero-tagline">{s.heroTagline}</p>

    <div class="hero-badges">
      <span class="badge-shield">
        <span class="badge-label">{s.heroBadgeLabelWorkflows}</span>
        <span class="badge-value">{s.heroBadgeWorkflows}</span>
      </span>
      <span class="badge-shield">
        <span class="badge-label">{s.heroBadgeLabelPrompts}</span>
        <span class="badge-value">{s.heroBadgePrompts}</span>
      </span>
      <span class="badge-shield">
        <span class="badge-label">{s.heroBadgeLabelRules}</span>
        <span class="badge-value">{s.heroBadgeRules}</span>
      </span>
    </div>

    <div class="hero-ctas">
      <a href="/guide/" class="btn btn-primary">
        {s.heroCta}
      </a>
      <a href="#workflows" class="btn btn-secondary">
        {s.heroCtaSecondary}
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-4xl) 0 var(--space-3xl);
    background: var(--bg-primary);
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: var(--space-md);
    color: var(--text-primary);
  }

  .hero-tagline {
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
  }

  .hero-badges {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-xl);
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-md);
    justify-content: flex-start;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .hero { padding: var(--space-3xl) 0 var(--space-2xl); }
    .hero-title { font-size: clamp(2rem, 8vw, 3rem); }
  }
</style>
