---
import AuthorProfile from './AuthorProfile.astro'
import type { Lang } from '../../data/i18n'
import { t } from '../../data/i18n'

interface Props { lang: Lang }
const { lang } = Astro.props
const s = t(lang)

const ghUrl = 'https://github.com/FlorianBruniaux/claude-cowork-guide'
const isEn = lang === 'en'
---

<section class="hero band band-ink band-hero section-wallpaper" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero-copy">
      <p class="hero-kicker">{s.heroKicker}</p>
      <div class="hero-heading">
        <h1 id="hero-title" class="hero-title">{s.heroTitle}</h1>
      </div>
      <div class="hero-body">
        <p class="hero-tagline">{s.heroTagline}</p>
        <div class="hero-actions hero-ctas">
          <a href="/guide/" class="btn btn-primary" data-astro-prefetch="false">{s.heroCta}</a>
          <a href={isEn ? '/workflows/' : '/fr/workflows/'} class="btn btn-secondary">{s.heroCtaSecondary}</a>
        </div>
        <nav class="hero-beyond hero-quick-nav" aria-label={s.heroQuickNavigation}>
          <p class="hero-beyond-label quick-nav-label">{s.heroQuickLabel}</p>
          <ul>
            <li><a href={isEn ? '/workflows/' : '/fr/workflows/'}>29 Workflows</a></li>
            <li><a href={isEn ? '/prompts/' : '/fr/prompts/'}>70 Prompts</a></li>
            <li><a href={isEn ? '/glossary/' : '/fr/glossary/'}>{s.heroGlossary}</a></li>
            <li><a href={isEn ? '/faq/' : '/fr/faq/'}>FAQ</a></li>
          </ul>
        </nav>
      </div>
      <div class="hero-evidence">
        <div class="proof-strip hero-badges" aria-label={s.heroHighlights}>
          <a href={ghUrl} target="_blank" rel="noopener" class="proof-item proof-stars">
            <span aria-hidden="true">★</span><strong id="hero-stars">—</strong><span>GitHub stars</span>
          </a>
          <a href={isEn ? '/workflows/' : '/fr/workflows/'} class="proof-item"><strong>{s.heroBadgeWorkflows}</strong><span>{s.heroBadgeLabelWorkflows}</span></a>
          <a href={isEn ? '/prompts/' : '/fr/prompts/'} class="proof-item"><strong>{s.heroBadgePrompts}</strong><span>{s.heroBadgeLabelPrompts}</span></a>
          <span class="proof-item"><strong>{s.heroBadgeRules}</strong><span>{s.heroBadgeLabelRules}</span></span>
          <a href={ghUrl} target="_blank" rel="noopener" class="proof-item proof-license">CC BY-SA 4.0</a>
        </div>
        <AuthorProfile lang={lang} />
      </div>
    </div>
  </div>
</section>

<script is:inline>
  async function loadStars() {
    try {
      const res = await fetch('https://api.github.com/repos/FlorianBruniaux/claude-cowork-guide')
      if (res.ok) {
        const data = await res.json()
        const stars = Number(data.stargazers_count)
        const el = document.getElementById('hero-stars')
        if (el && stars) {
          el.textContent = stars >= 1000
            ? (stars / 1000).toFixed(1).replace(/\.0$/, '') + 'k'
            : String(stars)
        }
      }
    } catch {
      const el = document.getElementById('hero-stars')
      if (el) el.textContent = '★'
    }
  }
  // Defer the GitHub API call until the page is idle so it stays off the critical path.
  const schedule = () =>
    'requestIdleCallback' in window ? requestIdleCallback(() => loadStars()) : setTimeout(loadStars, 1)
  if (document.readyState === 'complete') schedule()
  else window.addEventListener('load', schedule, { once: true })
</script>

<style>
  .hero {
    padding: clamp(3.5rem, 7vw, 5.5rem) 0 clamp(3rem, 6vw, 4.5rem);
  }

  .hero .container { max-width: var(--max-width); }

  .hero-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(320px, 0.8fr);
    grid-template-areas:
      "kicker kicker"
      "heading heading"
      "body evidence";
    column-gap: clamp(2.5rem, 6vw, 6rem);
  }

  .hero-kicker {
    grid-area: kicker;
    margin: 0 0 0.85rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .hero-heading {
    grid-area: heading;
    display: flex;
    align-items: center;
    gap: 1rem;
  }


  h1 {
    margin: 0;
    font-size: clamp(2.8rem, 6.6vw, 5.4rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.015em;
  }

  .hero-body {
    grid-area: body;
    min-width: 0;
  }

  .hero-tagline {
    max-width: 780px;
    margin: 1.5rem 0 0;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    text-wrap: balance;
  }


  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .hero-beyond {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .hero-beyond-label {
    margin: 0;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .hero-beyond ul {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
    column-gap: 1.1rem;
  }

  .hero-beyond a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .hero-beyond a:hover,
  .hero-beyond a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .hero-beyond a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .proof-strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .hero-evidence {
    grid-area: evidence;
    align-self: end;
    min-width: 0;
    margin-top: 1.5rem;
  }

  .proof-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    padding: 0.45rem 0.7rem;
    color: var(--text-secondary) !important;
    background: color-mix(in srgb, var(--surface-elevated) 72%, transparent);
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    font-size: 0.825rem;
    line-height: 1;
    text-decoration: none !important;
  }

  .proof-item strong {
    color: var(--text-primary);
    font-family: var(--font-mono);
  }

  .proof-item:hover { border-color: var(--accent); }

  @media (max-width: 1100px) {
    .hero-copy {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "kicker"
        "heading"
        "body"
        "evidence";
    }

    .hero-evidence { max-width: 900px; }

    .proof-strip {
      display: flex;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 640px) {
    .hero { padding: 2.75rem 0 1.5rem; }
    .hero-heading { align-items: flex-start; gap: 0.65rem; }
    h1 { font-size: clamp(2.2rem, 12vw, 3.25rem); }
    .hero-tagline { margin-top: 1.1rem; }
    .hero-actions { align-items: stretch; }
    .hero-actions .btn { flex: 1 1 100%; }
    .proof-strip { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .proof-item { justify-content: center; }
  }
  .proof-license { grid-column: 1 / -1; }
</style>
