---
import type { Lang } from '../../data/i18n'
import { t } from '../../data/i18n'

interface Props { lang: Lang }
const s = t(Astro.props.lang)
---

<section class="section section--compact band band-paper section-wallpaper">
  <div class="container">
    <h2 class="section-title">{s.relatedTitle}</h2>

    <div class="related-grid">
      {s.relatedProjects.map((project) => (
        <a href={project.url} target="_blank" rel="noopener" class="related-card brand-card brand-interactive-card">
          {'badge' in project && project.badge && (
            <span class="related-badge">{project.badge}</span>
          )}
          <span class="related-icon">{project.icon}</span>
          <h3>{project.title}</h3>
          <p>{project.desc}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-md);
  }

  .related-card {
    padding: var(--space-lg);
    text-decoration: none !important;
    color: inherit;
    position: relative;
  }

  .related-card:hover h3,
  .related-card:focus-visible h3 { text-decoration: underline; }

  .related-badge {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    background: var(--action);
    color: var(--action-ink);
    border-radius: var(--radius-control);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .related-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: var(--space-sm);
    font-family: var(--font-mono);
    color: var(--accent);
  }

  .related-card h3 {
    font-size: 1rem;
    margin-bottom: var(--space-xs);
  }

  .related-card p {
    color: var(--text-secondary);
    font-size: 0.85rem;
    margin: 0;
  }
</style>
