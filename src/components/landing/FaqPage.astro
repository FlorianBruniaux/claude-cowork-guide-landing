---
import Layout from '../../layouts/Layout.astro'
import ChapterLabel from '../global/ChapterLabel.astro'
import type { Lang } from '../../data/i18n'
import { FAQ_UPDATED, answerText, faqByLang } from '../../data/faq-data'

const { lang } = Astro.props as { lang: Lang }
const isFr = lang === 'fr'
const sections = faqByLang[lang]
const count = sections.flatMap(section => section.items).length
const title = isFr ? 'FAQ Claude Cowork : accès, plateformes et sécurité' : 'Claude Cowork FAQ: Access, Platforms, and Safety'
const description = isFr ? `${count} réponses vérifiées sur les plans, plateformes, exécution isolée, connecteurs et sécurité de Claude Cowork.` : `${count} verified answers about Claude Cowork plans, platforms, isolated execution, connectors, and safety.`
const pageUrl = `https://cowork.bruniaux.com/${isFr ? 'fr/faq/' : 'faq/'}`
const jsonLd = [
  { '@type': 'WebPage', '@id': `${pageUrl}#webpage`, name: title, description, url: pageUrl, dateModified: FAQ_UPDATED, inLanguage: lang, isPartOf: { '@id': 'https://cowork.bruniaux.com/#website' }, author: { '@id': 'https://cowork.bruniaux.com/#person' } },
  { '@type': 'FAQPage', '@id': `${pageUrl}#faq`, mainEntity: sections.flatMap(section => section.items).map(item => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: answerText(item.answerHtml) } })) },
]
---

<Layout lang={lang} title={title} description={description} jsonLd={jsonLd}>
  <header class="page-hero"><div class="container">
    <a href={isFr ? '/fr/' : '/'} class="back-link">← {isFr ? 'Guide Claude Cowork' : 'Claude Cowork Guide'}</a>
    <h1>{isFr ? 'FAQ Claude Cowork' : 'Claude Cowork FAQ'}</h1>
    <p class="tagline">{description}</p>
    <p class="verified">{isFr ? 'Informations produit vérifiées' : 'Product information verified'}: <time datetime={FAQ_UPDATED}>{FAQ_UPDATED}</time></p>
  </div></header>
  {sections.map((section, i) => (
    <section class:list={['band', 'faq-band', ['band-base', 'band-ink section-wallpaper', 'band-paper section-wallpaper'][i % 3]]}>
      <div class="container faq-page">
        <ChapterLabel number={String(i + 1).padStart(2, '0')} label={section.title} />
        <h2 class="faq-section-title">{section.title}</h2>
        <div class="faq-list">{section.items.map(item => (
          <details class="faq-item brand-card"><summary>{item.question}</summary><p set:html={item.answerHtml} /></details>
        ))}</div>
      </div>
    </section>
  ))}
  <style>
    .page-hero{padding:4rem 0 3rem}
    .back-link{display:inline-block;color:var(--accent);font-size:.875rem;margin-bottom:var(--space-md)}
    .page-hero h1{margin-bottom:var(--space-md)}.tagline{color:var(--text-secondary);font-size:1.1rem;max-width:720px}.verified{color:var(--text-secondary);font-size:.875rem;margin-top:var(--space-sm)}
    .faq-band{padding:var(--space-3xl) 0}
    .faq-list{max-width:56rem}.faq-section-title{font-size:1.5rem;color:var(--text-primary);margin:0 0 var(--space-lg)}
    .faq-item{margin-bottom:var(--space-md);overflow:hidden;transition:border-color 150ms ease,box-shadow 150ms ease}
    .faq-item:hover{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}
    .faq-item[open]{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent),4px 4px 0 var(--border)}
    .faq-item summary{padding:var(--space-lg);cursor:pointer;font-weight:500;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:var(--space-md);min-height:44px}
    .faq-item summary:focus-visible{outline:2px solid var(--accent);outline-offset:-3px}
    .faq-item summary::-webkit-details-marker{display:none}.faq-item summary::after{content:'+';font-size:1.5rem;color:var(--text-secondary);flex-shrink:0}.faq-item[open] summary::after{content:'−'}.faq-item[open] summary{border-bottom:1px solid var(--border)}
    .faq-item p{padding:var(--space-lg);color:var(--text-secondary);margin:0;line-height:1.7}
    @media (prefers-reduced-motion:reduce){.faq-item{transition:none}}
  </style>
</Layout>
