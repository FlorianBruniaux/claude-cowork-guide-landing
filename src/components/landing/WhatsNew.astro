---
import type { Lang } from '../../data/i18n'
import { t } from '../../data/i18n'

interface Props { lang: Lang }
const s = t(Astro.props.lang)
---

<section class="section section--compact whats-new band band-paper section-wallpaper">
  <div class="container">
    <div class="whats-new-inner">
      <span class="section-badge">{s.whatsNewBadge}</span>
      <h2>{s.whatsNewTitle}</h2>
      <p>{s.whatsNewText} <strong>{s.whatsNewWarning}</strong></p>
      <a href={s.whatsNewUrl} class="btn btn-secondary" target="_blank" rel="noopener">
        {s.whatsNewCta}
      </a>
    </div>
  </div>
</section>

<style>
  .whats-new-inner .section-badge {
    background: var(--action);
    color: var(--action-ink);
    font-family: var(--font-mono);
    border-radius: var(--radius-control);
  }

  .whats-new-inner h2 {
    margin: var(--space-md) 0 var(--space-sm);
    font-size: 1.25rem;
  }

  .whats-new-inner p {
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
  }
</style>