---
import type { Lang } from '../../data/i18n'
import { t } from '../../data/i18n'
import ChapterLabel from '../global/ChapterLabel.astro'

interface Props { lang: Lang }
const s = t(Astro.props.lang)
---

<section class="section getting-started band band-ink section-wallpaper">
  <div class="container">
    <ChapterLabel number="01" label={s.gettingStartedBadge} />
    <h2 class="section-title">{s.gettingStartedTitle}</h2>
    <p class="section-subtitle">{s.gettingStartedSubtitle}</p>
    <div class="setup-steps">
      <div class="setup-step brand-card">
        <span class="step-num">1</span>
        <h3>{s.step1Title}</h3>
        <p set:html={s.step1Text} />
      </div>
      <div class="setup-step brand-card">
        <span class="step-num">2</span>
        <h3>{s.step2Title}</h3>
        <p set:html={s.step2Text} />
      </div>
      <div class="setup-step brand-card">
        <span class="step-num">3</span>
        <h3>{s.step3Title}</h3>
        <p set:html={s.step3Text} />
      </div>
    </div>
  </div>
</section>

<style>
  .setup-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-lg);
  }

  .setup-step {
    padding: var(--space-xl);
    position: relative;
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--action);
    color: var(--action-ink);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.1rem;
    border-radius: var(--radius-control);
    margin-bottom: var(--space-md);
  }

  .setup-step h3 {
    font-size: 1.1rem;
    margin-bottom: var(--space-sm);
  }

  .setup-step p {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
</style>
