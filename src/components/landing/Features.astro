---
import type { Lang } from '../../data/i18n'
import { t } from '../../data/i18n'
import ChapterLabel from '../global/ChapterLabel.astro'

interface Props { lang: Lang }
const s = t(Astro.props.lang)
const features = s.features as readonly (typeof s.features[number] & { featured?: boolean; badge?: string })[]
---

<section class="section band band-paper section-wallpaper" id="features">
  <div class="container">
    <ChapterLabel number="02" label={s.featuresBadge} />
    <h2 class="section-title">{s.featuresTitle}</h2>
    <p class="section-subtitle">{s.featuresSubtitle}</p>
    <div class="features-grid">
      {features.map((f) => (
        <a href={f.url} target={f.url.startsWith('http') ? '_blank' : undefined} rel={f.url.startsWith('http') ? 'noopener' : undefined} class:list={['feature-card', 'brand-card', 'brand-interactive-card', { featured: f.featured }]}>
          {f.badge && <span class="feature-badge">{f.badge}</span>}
          <span class="feature-icon">{f.icon}</span>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
          <span class="feature-meta">{f.meta}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
  }

  .feature-card {
    padding: var(--space-xl);
    text-decoration: none !important;
    color: inherit;
    position: relative;
  }

  .feature-card:hover h3,
  .feature-card:focus-visible h3 { text-decoration: underline; }

  .feature-card.featured {
    border-color: var(--accent);
    border-width: 2px;
  }

  .feature-badge {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    background: var(--action);
    color: var(--action-ink);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-control);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .feature-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: var(--space-sm);
  }

  .feature-card h3 {
    font-size: 1.1rem;
    margin-bottom: var(--space-xs);
  }

  .feature-card p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: var(--space-sm);
  }

  .feature-meta {
    font-size: 0.8rem;
    color: var(--accent);
    font-weight: 600;
  }
</style>
