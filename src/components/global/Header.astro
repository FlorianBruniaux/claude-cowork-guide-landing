---
import type { Lang } from '../../data/i18n'
import { t } from '../../data/i18n'
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const s = t(lang)

// Compute dynamic language switch URL from current path
const currentPath = Astro.url.pathname
let langSwitchUrl: string
if (lang === 'en') {
  langSwitchUrl = '/fr' + currentPath
} else {
  langSwitchUrl = currentPath.replace(/^\/fr/, '') || '/'
}
---

<header class="header">
  <nav class="nav container">
    <a href={lang === 'fr' ? '/fr/' : '/'} class="logo">
      <span class="logo-icon">&gt;_</span>
      <span class="logo-text">{s.logoText}</span>
    </a>
    <div class="nav-links">
      <a href={s.navGuideUrl}>{s.navGuide}</a>
      <a href="#features">{s.navFeatures}</a>
      <a href="#workflows">{s.navWorkflows}</a>
      <a href="#prompts">{s.navPrompts}</a>
      <a href="#compare">{s.navCompare}</a>
      <a href={s.navFaqUrl}>{s.navFaq}</a>
      <a href={s.navWhitepapersUrl}>{s.navWhitepapers}</a>
      <div class="nav-actions">
        <button id="search-trigger" class="search-trigger" aria-label={s.searchLabel}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <span class="search-kbd">Cmd+K</span>
        </button>
        <a href={langSwitchUrl} class="lang-switcher" title={s.langSwitchLabel}>🌐 {s.langSwitchText}</a>
        <ThemeToggle />
        <a href="https://github.com/FlorianBruniaux/claude-cowork-guide" class="btn btn-primary" target="_blank" rel="noopener">{s.readGuide}</a>
      </div>
    </div>
    <button class="menu-toggle" aria-label={s.menuToggle} aria-expanded="false">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </nav>
</header>

<script>
  // Mobile menu toggle
  document.querySelector('.menu-toggle')?.addEventListener('click', function(this: HTMLElement) {
    const navLinks = document.querySelector('.nav-links')
    if (!navLinks) return
    const isActive = navLinks.classList.toggle('active')
    this.setAttribute('aria-expanded', String(isActive))
  })

  // Theme toggle is handled by ThemeToggle.astro component
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-header);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.5rem;
    gap: 1rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-primary);
    font-weight: 700;
    font-size: 1rem;
    flex-shrink: 0;
  }

  .logo:hover { text-decoration: none; color: var(--text-primary); }

  .logo-icon {
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-links a:not(.btn):not(.lang-switcher) {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color var(--transition-fast);
  }

  .nav-links a:not(.btn):not(.lang-switcher):hover {
    color: var(--accent);
    text-decoration: none;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .lang-switcher {
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    transition: color var(--transition-fast);
  }

  .lang-switcher:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    color: var(--text-primary);
    min-height: 44px;
    min-width: 44px;
  }

  .menu-toggle svg {
    width: 24px;
    height: 24px;
  }

  @media (max-width: 900px) {
    .nav-links { display: none; }
    .nav-links.active {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 3.5rem;
      left: 0;
      right: 0;
      background: var(--bg-primary);
      border-bottom: 1px solid var(--border);
      padding: 1rem var(--space-lg);
      gap: 1rem;
      z-index: 99;
    }
    .nav-actions { flex-wrap: wrap; }
    .menu-toggle { display: flex; align-items: center; justify-content: center; }
  }
</style>