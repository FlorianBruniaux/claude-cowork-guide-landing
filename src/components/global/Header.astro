---
import type { Lang } from '../../data/i18n'
import { t } from '../../data/i18n'
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const s = t(lang)

// Compute dynamic language switch URL from current path
const currentPath = Astro.url.pathname
let langSwitchUrl: string
if (lang === 'en') {
  langSwitchUrl = '/fr' + currentPath
} else {
  langSwitchUrl = currentPath.replace(/^\/fr/, '') || '/'
}

const mainLinks = [
  { label: s.navGuide, url: s.navGuideUrl },
  { label: s.navWorkflows, url: s.navWorkflowsUrl },
  { label: s.navPrompts, url: s.navPromptsUrl },
  { label: s.navWhitepapers, url: s.navWhitepapersUrl },
]

const moreLinks = [
  { label: s.navReleases, url: s.navReleasesUrl },
  { label: s.navFaq, url: s.navFaqUrl },
  { label: s.navCompare, url: s.navCompareUrl },
  { label: s.navKeyTerms, url: s.navKeyTermsUrl },
  { label: s.navRss, url: s.navRssUrl, icon: 'rss' },
]

function isActiveLink(url: string): boolean {
  if (url.startsWith('#')) return false
  return currentPath.startsWith(url)
}

const isMoreActive = moreLinks.some((link) => isActiveLink(link.url))
---

<header class="header site-header">
  <nav class="nav container">
    <a href={lang === 'fr' ? '/fr/' : '/'} class="logo">
      <span class="logo-icon">&gt;_</span>
      <span class="logo-text">{s.logoText}</span>
    </a>

    <div class="nav-links" id="nav-links-drawer">
      <button class="drawer-close" id="drawer-close" aria-label="Close menu">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>

      {mainLinks.map((link) => (
        <a
          href={link.url}
          class:list={['nav-link', { active: isActiveLink(link.url) }]}
          aria-current={isActiveLink(link.url) ? 'page' : undefined}
          data-astro-prefetch={link.url.startsWith('/guide') ? 'false' : undefined}
        >
          {link.label}
        </a>
      ))}

      <div class="nav-more" id="nav-more-dropdown">
        <button
          class:list={['nav-more-trigger', { active: isMoreActive }]}
          aria-haspopup="true"
          aria-expanded="false"
          id="more-btn"
        >
          {s.navMore}
          <svg class="more-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
        <div class="nav-more-menu" role="menu" aria-labelledby="more-btn">
          <div class="more-panel-header" aria-hidden="true"><strong>{s.navMore}</strong></div>
          {moreLinks.map((link) => (
            <a
              href={link.url}
              role="menuitem"
              class:list={['more-menu-item', { active: isActiveLink(link.url), 'more-item-rss': link.icon === 'rss' }]}
              aria-current={isActiveLink(link.url) ? 'page' : undefined}
            >
              {link.icon === 'rss' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
                  width="13" height="13" aria-hidden="true" class="rss-icon">
                  <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20
                    C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0
                    0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9
                    9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
                </svg>
              )}
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="nav-actions">
      <button id="search-trigger" class="search-trigger" aria-label={s.searchLabel}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"
          aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <kbd class="search-kbd">⌘K</kbd>
      </button>

      <a href={langSwitchUrl} class="lang-switcher" title={s.langSwitchLabel}>
        🌐 {s.langSwitchText}
      </a>

      <ThemeToggle />

      <a
        href="https://github.com/FlorianBruniaux/claude-cowork-guide"
        class="btn btn-outline btn-icon"
        target="_blank"
        rel="noopener"
        aria-label={s.navGithub}
      >
        <svg viewBox="0 0 16 16" fill="currentColor" width="16" height="16" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
            0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13
            -.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66
            .07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15
            -.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0
            1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82
            1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01
            1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
      </a>

      <a href="/guide/" class="btn btn-secondary header-guide-link" data-astro-prefetch="false">{s.readGuide}</a>
    </div>

    <button class="menu-toggle" id="menu-toggle" aria-label={s.menuToggle} aria-expanded="false"
      aria-controls="nav-links-drawer">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"
        aria-hidden="true">
        <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </nav>
</header>

<script>
  // ── More dropdown ──────────────────────────────────────────────────────────
  const moreBtn = document.getElementById('more-btn') as HTMLButtonElement | null
  const moreMenu = document.querySelector('.nav-more-menu') as HTMLElement | null

  function openMore() {
    moreMenu?.classList.add('open')
    moreBtn?.setAttribute('aria-expanded', 'true')
  }

  function closeMore() {
    moreMenu?.classList.remove('open')
    moreBtn?.setAttribute('aria-expanded', 'false')
  }

  moreBtn?.addEventListener('click', (e) => {
    e.stopPropagation()
    moreMenu?.classList.contains('open') ? closeMore() : openMore()
  })

  document.addEventListener('click', (e) => {
    const target = e.target as Element
    if (!target.closest('#nav-more-dropdown')) {
      closeMore()
    }
  })

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeMore()
      moreBtn?.focus()
    }
  })

  // ── Mobile drawer ──────────────────────────────────────────────────────────
  const menuToggle = document.getElementById('menu-toggle') as HTMLButtonElement | null
  const drawer = document.getElementById('nav-links-drawer') as HTMLElement | null
  const drawerClose = document.getElementById('drawer-close') as HTMLButtonElement | null

  function openDrawer() {
    drawer?.classList.add('active')
    menuToggle?.setAttribute('aria-expanded', 'true')
    document.body.style.overflow = 'hidden'
    drawerClose?.focus()
  }

  function closeDrawer() {
    drawer?.classList.remove('active')
    menuToggle?.setAttribute('aria-expanded', 'false')
    document.body.style.overflow = ''
    menuToggle?.focus()
  }

  menuToggle?.addEventListener('click', openDrawer)
  drawerClose?.addEventListener('click', closeDrawer)

  // Close on nav link click (anchors close the drawer)
  drawer?.querySelectorAll('a[href]').forEach((link) => {
    link.addEventListener('click', () => {
      if (drawer.classList.contains('active')) closeDrawer()
    })
  })

  // Escape closes drawer
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer?.classList.contains('active')) closeDrawer()
  })

  // Basic focus trap: Tab on last focusable goes back to first, Shift+Tab on first goes to last
  drawer?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return
    const focusable = Array.from(
      drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
    )
    const first = focusable[0]
    const last = focusable[focusable.length - 1]

    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault()
      last.focus()
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault()
      first.focus()
    }
  })
</script>

<style>
  /* Pilot header (claude-code-ultimate-guide-landing@6b2e3b5 Header.astro): mono brand
     lockup in link colour, quiet secondary links with a 4px orange bar under the current
     item, boxed search, ghost icons, secondary guide action, "More" as an intent panel
     (charcoal strip, cards), mobile drawer from the right over a dimmed page. */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg-primary) 94%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .nav {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    height: 3.5rem;
    gap: 1rem;
  }

  /* ── Brand ──────────────────────────────────────────────────────────────── */

  .header .nav .logo {
    display: inline-flex;
    align-items: center;
    align-self: center;
    gap: 0.55rem;
    min-height: 44px;
    flex-shrink: 0;
    color: var(--accent);
    font: 400 0.875rem/1 var(--font-mono);
    letter-spacing: 0.01em;
    white-space: nowrap;
    text-decoration: none;
    transition: opacity 160ms ease;
  }

  .header .nav .logo:hover {
    opacity: 0.78;
    color: var(--accent);
    text-decoration: none;
  }

  .logo-icon {
    color: var(--action);
    font: 700 1rem/1 var(--font-mono);
  }

  /* ── Nav links ──────────────────────────────────────────────────────────── */

  .nav-links {
    display: flex;
    align-items: stretch;
    gap: clamp(0.05rem, 0.3vw, 0.3rem);
    flex: 1;
    justify-content: center;
  }

  .nav .nav-links .nav-link,
  .nav-more-trigger {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0 clamp(0.45rem, 0.7vw, 0.7rem);
    color: var(--text-secondary);
    font: 600 0.84rem/1 var(--font-sans);
    white-space: nowrap;
    text-decoration: none;
    transition: color 160ms ease;
  }

  /* Hover and open fill: a rounded 44px pad, the bar keeps the header line. */
  .nav .nav-links .nav-link::before,
  .nav-more-trigger::before {
    content: '';
    position: absolute;
    inset: 0.375rem 0;
    z-index: -1;
    border-radius: 0.5rem;
    background: transparent;
    transition: background-color 160ms ease;
  }

  .nav .nav-links .nav-link:hover,
  .nav-more-trigger:hover {
    color: var(--text-primary);
    text-decoration: none;
  }

  .nav .nav-links .nav-link.active,
  .nav-more-trigger.active {
    color: var(--accent);
  }

  .nav-link.active::after,
  .nav-more-trigger.active::after {
    content: '';
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 0;
    height: 4px;
    background: var(--action);
  }

  .nav-link:focus-visible,
  .nav-more-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -6px;
    border-radius: 0.5rem;
  }

  /* ── More: intent panel ─────────────────────────────────────────────────── */

  .nav-more {
    position: relative;
    display: flex;
  }

  .nav-more-trigger {
    background: none;
    border: none;
    cursor: pointer;
  }

  .nav-more-trigger[aria-expanded="true"] {
    color: var(--text-primary);
  }

  .nav-more-trigger[aria-expanded="true"]::before {
    background: var(--bg-tertiary);
  }

  .more-chevron {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform 160ms ease;
  }

  .nav-more-trigger[aria-expanded="true"] .more-chevron {
    transform: rotate(180deg);
  }

  .nav-more-menu {
    display: none;
    z-index: 200;
  }

  .more-panel-header {
    display: none;
  }

  .more-menu-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .rss-icon {
    flex-shrink: 0;
    color: var(--accent);
  }

  @media (min-width: 901px) {
    .nav-more-menu {
      position: absolute;
      top: calc(100% + 2px);
      right: -1rem;
      width: min(30rem, calc(100vw - 2rem));
      padding: 1.25rem 1.5rem 1.4rem;
      border: 1px solid var(--border);
      border-top: 3px solid var(--action);
      border-radius: 0 0 var(--border-radius-lg) var(--border-radius-lg);
      background: var(--bg-primary);
      box-shadow: 0 12px 24px rgb(0 0 0 / 0.13);
    }

    .nav-more-menu.open {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }

    /* Charcoal strip at the top of the panel, as the pilot intent panels. */
    .more-panel-header {
      position: relative;
      isolation: isolate;
      display: flex;
      grid-column: 1 / -1;
      margin: -1.25rem -1.5rem 0.5rem;
      padding: 0.95rem 1.5rem;
      background: #191b1d;
      color: #f5f0e6;
      font-size: 1.05rem;
    }

    .more-panel-header::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background: url('/images/brand/section-hatching.svg') repeat;
      background-size: 160px 160px;
      opacity: 0.09;
    }

    /* Essentials: cards, inset line and 4px hard shadow on hover, no lift. */
    .nav .nav-more-menu .more-menu-item {
      min-height: 48px;
      padding: 0.85rem 1rem;
      border: 1px solid var(--border);
      border-radius: var(--border-radius-lg);
      background: var(--surface-elevated);
      color: var(--text-primary);
      font: 600 0.92rem/1.3 var(--font-sans);
      text-decoration: none !important;
      transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease, box-shadow 150ms ease;
    }

    .nav .nav-more-menu .more-menu-item:is(:hover, :focus-visible),
    .nav .nav-more-menu .more-menu-item.active {
      border-color: var(--accent);
      background: var(--surface-elevated);
      color: var(--text-primary);
      box-shadow: inset 0 0 0 1px var(--accent), 4px 4px 0 var(--border);
    }

    :root:not([data-theme='dark']) .nav .nav-more-menu .more-menu-item:not(.more-item-rss):is(:hover, :focus-visible) {
      border-color: #0a0a0a;
      background: #f97316;
      color: #0a0a0a;
      box-shadow: inset 0 0 0 1px #0a0a0a, 4px 4px 0 #0a0a0a;
    }

    .nav .nav-more-menu .more-menu-item:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    /* Go further: the feed reads as a plain row under a rule. */
    .nav .nav-more-menu .more-item-rss {
      grid-column: 1 / -1;
      min-height: 44px;
      margin: 0.25rem -0.6rem 0;
      padding: 0.55rem 0.6rem;
      border: 0;
      border-radius: var(--radius-control);
      background: transparent;
      box-shadow: 0 -1px 0 var(--border-light);
      font-size: 0.84rem;
    }

    .nav .nav-more-menu .more-item-rss:is(:hover, :focus-visible) {
      border: 0;
      background: var(--bg-tertiary);
      box-shadow: none;
      text-decoration: underline !important;
      text-decoration-thickness: 1px !important;
      text-underline-offset: 0.22em;
    }
  }

  /* ── Nav actions ────────────────────────────────────────────────────────── */

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    flex-shrink: 0;
  }

  /* Boxed search, as the portfolio header. */
  .search-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.65rem;
    border: 1px solid color-mix(in srgb, var(--text-primary) 56%, var(--bg-primary));
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background-color 160ms ease;
  }

  .search-trigger:hover,
  .search-trigger:focus-visible {
    border-color: var(--border);
    background: var(--bg-tertiary);
  }

  .search-kbd {
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    background: var(--bg-tertiary);
    color: var(--text-muted);
    font: 400 0.7rem/1.3 var(--font-mono);
  }

  @media (max-width: 1024px) {
    .search-kbd { display: none; }
  }

  /* Ghost controls: language and GitHub, framed only on hover. */
  .nav .nav-actions .lang-switcher,
  .nav .nav-actions .btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.6rem;
    border: 1px solid transparent;
    border-radius: var(--border-radius);
    background: transparent;
    color: var(--text-secondary);
    font: 600 0.85rem/1 var(--font-sans);
    text-decoration: none;
    white-space: nowrap;
    transition: color 160ms ease, border-color 160ms ease, background-color 160ms ease;
  }

  .nav .nav-actions .btn-icon {
    width: 44px;
    height: 44px;
    padding: 0;
  }

  .nav .nav-actions .lang-switcher:is(:hover, :focus-visible),
  .nav .nav-actions .btn-icon:is(:hover, :focus-visible) {
    border-color: var(--border);
    background: var(--bg-tertiary);
    color: var(--text-primary);
    text-decoration: none;
  }

  /* Guide action at the secondary level, as the pilot "All pages" button. */
  .nav .nav-actions .header-guide-link {
    min-height: 44px;
    padding: 0 0.8rem;
    font-size: 0.85rem;
  }

  /* ── Mobile toggle ──────────────────────────────────────────────────────── */

  .menu-toggle {
    display: none;
    align-self: center;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0.65rem;
    border: 1px solid transparent;
    border-radius: var(--border-radius);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background-color 160ms ease;
  }

  .menu-toggle:hover,
  .menu-toggle:focus-visible {
    border-color: var(--border);
    background: var(--bg-tertiary);
    color: var(--text-primary);
  }

  /* ── Drawer close button (hidden on desktop) ────────────────────────────── */

  .drawer-close {
    display: none;
    flex: 0 0 auto;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--bg-secondary);
    color: var(--text-primary);
    cursor: pointer;
  }

  .drawer-close:hover,
  .drawer-close:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ── Responsive ─────────────────────────────────────────────────────────── */

  @media (max-width: 900px) {
    /* backdrop-filter makes the header the containing block of the fixed drawer,
       which then stays 56px tall: the mobile header is opaque instead. */
    .header {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: var(--bg-primary);
    }

    /* Drawer from the right, under the header, over a dimmed page. */
    .nav-links {
      display: none;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      position: fixed;
      top: 3.625rem;
      right: 0;
      bottom: 0;
      left: auto;
      width: min(24rem, calc(100vw - 1.25rem));
      padding: 0 1rem max(1rem, env(safe-area-inset-bottom));
      gap: 0;
      border-left: 1px solid var(--border);
      background: var(--bg-primary);
      box-shadow: -18px 0 48px rgb(0 0 0 / 0.26), 0 0 0 100vmax rgb(18 16 14 / 0.56);
      clip-path: inset(0 0 -100vh -100vw);
      overflow-y: auto;
      overscroll-behavior: contain;
      z-index: 99;
    }

    .nav-links.active {
      display: flex;
    }

    .drawer-close {
      display: inline-grid;
      align-self: flex-end;
      margin: 0.75rem 0;
    }

    .nav .nav-links .nav-link,
    .nav-more-trigger {
      width: 100%;
      min-height: 44px;
      padding: 0.65rem 0.25rem;
      border-top: 1px solid var(--border-light);
      font-size: 0.95rem;
    }

    .nav .nav-links .nav-link::before,
    .nav-more-trigger::before,
    .nav-link.active::after,
    .nav-more-trigger.active::after {
      display: none;
    }

    .nav .nav-links .nav-link:hover,
    .nav-more-trigger:hover {
      color: var(--accent);
    }

    .nav-more {
      flex-direction: column;
      width: 100%;
    }

    .nav-more-trigger {
      justify-content: space-between;
    }

    .nav-more-menu {
      position: static;
      flex-direction: column;
      padding: 0 0 0.75rem;
    }

    .nav-more-menu.open {
      display: flex;
    }

    .nav .nav-more-menu .more-menu-item {
      min-height: 44px;
