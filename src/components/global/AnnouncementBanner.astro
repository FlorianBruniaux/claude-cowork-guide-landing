---
/**
 * AnnouncementBanner
 * Dismissible strip under the nav to surface major new content.
 * Update BANNER_ID whenever the message changes — resets dismissed state for all visitors.
 */
import type { Lang } from '../../data/i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const BANNER_ID = 'cowork-banner-new-identity-2026-11'
const isFr = lang === 'fr'

const links = isFr
  ? [
      { href: '/fr/whitepapers/', label: '17 Whitepapers Cowork — guides PDF gratuits →' },
      { href: '/fr/workflows/', label: '29 Workflows →' },
      { href: '/fr/prompts/', label: '70 Prompts →' },
    ]
  : [
      { href: '/whitepapers/', label: '17 Cowork Whitepapers — free PDF guides →' },
      { href: '/workflows/', label: '29 Workflows →' },
      { href: '/prompts/', label: '70 Prompts →' },
    ]
---

<div id="announcement-banner" class="ann-banner" data-banner-id={BANNER_ID} aria-label={isFr ? 'Annonce' : 'Announcement'}>
  <div class="ann-inner">
    <div class="ann-content">
      <span class="ann-badge">NEW</span>
      <span class="ann-badge ann-badge--new">{isFr ? 'Nouvelle identité' : 'New identity'}</span>
      <span class="ann-text">
        {links.map((link, i) => (
          <>
            {i > 0 && <span class="ann-sep" aria-hidden="true">·</span>}
            <a href={link.href} class="ann-link">{link.label}</a>
          </>
        ))}
      </span>
    </div>
    <button
      id="ann-close"
      class="ann-close"
      aria-label={isFr ? 'Fermer l\'annonce' : 'Dismiss announcement'}
      type="button"
    >×</button>
  </div>
</div>

<script>
  const banner = document.getElementById('announcement-banner')
  const BANNER_ID = banner?.dataset.bannerId ?? ''
  const STORAGE_KEY = `ann_dismissed_${BANNER_ID}`

  if (localStorage.getItem(STORAGE_KEY) === '1') {
    banner?.remove()
  }

  document.getElementById('ann-close')?.addEventListener('click', () => {
    localStorage.setItem(STORAGE_KEY, '1')
    banner?.remove()
  })
</script>

<style>
/* Portfolio strip: ivory surface under the orange header line, mono badges,
   underlined links. The date-like NEW badge drops under 640px, the identity badge stays. */
.ann-banner {
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border);
  font-size: 0.875rem;
  line-height: 1.4;
}

.ann-inner {
  max-width: var(--max-width, 75rem);
  margin: 0 auto;
  padding: 0.25rem 1rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.ann-content {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  flex: 1;
  min-width: 0;
}

.ann-badge {
  flex-shrink: 0;
  display: inline-block;
  padding: 0.2rem 0.5rem;
  background: #191b1d;
  color: #f5f0e6;
  font: 500 0.7rem/1.2 var(--font-mono);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border-radius: var(--radius-control);
}

/* Portfolio action fill: orange with ink text, distinct from the NEW badge. */
.ann-badge--new {
  background: var(--action);
  color: var(--action-ink);
  border: 1px solid #191b1d;
}

.ann-text {
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  gap: 0.25rem 0.5rem;
  flex-wrap: wrap;
  overflow: hidden;
}

.ann-banner .ann-text .ann-link {
  display: inline-flex;
  align-items: center;
  min-height: 36px;
  color: var(--accent);
  font-weight: 600;
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.2em;
  white-space: nowrap;
}

.ann-banner .ann-text .ann-link:hover {
  text-decoration-thickness: 2px;
}

.ann-sep {
  color: var(--text-muted);
  flex-shrink: 0;
  user-select: none;
}

.ann-close {
  flex-shrink: 0;
  min-width: 44px;
  min-height: 44px;
  background: none;
  border: 1px solid transparent;
  color: var(--text-secondary);
  font-size: 1.2rem;
  cursor: pointer;
  line-height: 1;
  border-radius: var(--radius-control);
  transition: background-color 0.15s, border-color 0.15s;
}

.ann-close:hover {
  background: var(--bg-tertiary);
  border-color: var(--border);
  color: var(--text-primary);
}

@media (max-width: 640px) {
  .ann-inner {
    padding: 0.25rem 1rem;
  }

  .ann-badge:not(.ann-badge--new) {
    display: none;
  }

  .ann-content { align-items: flex-start; padding-block: 0.4rem; }
  .ann-text { flex-direction: column; align-items: flex-start; gap: 0; }
  .ann-sep { display: none; }
  .ann-banner .ann-text .ann-link { white-space: normal; min-height: 32px; }
}
</style>
