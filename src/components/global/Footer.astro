---
import type { Lang } from '../../data/i18n'
import { t } from '../../data/i18n'
import { releases } from '../../data/releases'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const s = t(lang)
const latest = releases[0]
const releaseDate = new Date(`${latest.date} 12:00 UTC`).toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })

function isExternal(url: string): boolean {
  return url.startsWith('http://') || url.startsWith('https://')
}

// Ecosystem goes behind a disclosure, as "Explore the ecosystem" in the pilot footer.
const isEcosystem = (section: { links: { url: string }[] }) =>
  section.links.some((link) => link.url.startsWith('https://ccboard.'))
const gridSections = s.footerSections.filter((section) => !isEcosystem(section))
const ecosystemSection = s.footerSections.find(isEcosystem)
---

<footer class="footer site-footer-band">
  <div class="container">

    <div class="footer-cta">
      <div class="footer-cta-inner">
        <div class="footer-cta-text">
          <h2>{s.footerCtaTitle}</h2>
          <p>{s.footerCtaText}</p>
        </div>
        <div class="footer-cta-actions">
          <a href="/guide/" class="btn btn-primary" data-astro-prefetch="false">{s.footerCtaCta}</a>
          <a
            href="https://github.com/FlorianBruniaux/claude-cowork-guide"
            class="btn btn-outline"
            target="_blank"
            rel="noopener"
          >
            <svg viewBox="0 0 16 16" fill="currentColor" width="14" height="14" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
                0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13
                -.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66
                .07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15
                -.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0
                1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82
                1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01
                1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </svg>
            GitHub
          </a>
        </div>
      </div>
    </div>

    {Astro.url.pathname === (lang === 'fr' ? '/fr/' : '/') && <p class="footer-lead-links">
      <a href={`https://www.florian.bruniaux.com${lang === 'fr' ? '/fr/offres/formation/' : '/services/training/'}?utm_source=cowork-guide&utm_medium=cta&utm_campaign=harness-training#cohort`}>{lang === 'fr' ? 'Recevoir les dates de formation Claude Code et Codex' : 'Get Claude Code and Codex training dates'}</a>
      <a href={`https://www.florian.bruniaux.com${lang === 'fr' ? '/fr' : ''}/newsletter/?utm_source=cowork-guide&utm_medium=cta&utm_campaign=newsletter#newsletter`}>{lang === 'fr' ? 'S’inscrire à la newsletter de Florian' : 'Subscribe to Florian’s newsletter'}</a>
    </p>}

    <div class="footer-grid">
      <div class="footer-brand">
        <a href={lang === 'fr' ? '/fr/' : '/'} class="footer-brand-link">
          <span class="footer-brand-icon" aria-hidden="true">&gt;_</span>
          <span class="footer-brand-name">{s.logoText}</span>
        </a>
        <p class="footer-brand-text">{s.footerDisclaimer}</p>
      </div>
      {gridSections.map((section) => (
        <div class="footer-section">
          <h3>{section.title}</h3>
          <ul>
            {section.links.map((link) => (
              <li>
                {isExternal(link.url) ? (
                  <a href={link.url} target="_blank" rel="noopener">{link.text}</a>
                ) : (
                  <a href={link.url}>{link.text}</a>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    {ecosystemSection && (
      <details class="footer-ecosystem-toggle">
        <summary>
          <span>{ecosystemSection.title}</span>
          <span class="footer-ecosystem-plus" aria-hidden="true">+</span>
        </summary>
        <ul class="footer-ecosystem">
          {ecosystemSection.links.map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener">{link.text}</a>
            </li>
          ))}
        </ul>
      </details>
    )}

    <div class="footer-bottom">
      <div class="footer-bottom-left">
        <a href="/sitemap-index.xml" class="footer-meta-link">Sitemap</a>
        <span class="footer-sep" aria-hidden="true">·</span>
        <a href="/rss.xml" class="footer-meta-link">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
            width="12" height="12" aria-hidden="true" style="vertical-align: -1px">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20
              C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0
              0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9
              9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
          </svg>
          RSS
        </a>
        <span class="footer-sep" aria-hidden="true">·</span>
        <span class="footer-meta-text">CC BY-SA 4.0</span>
        <span class="footer-sep" aria-hidden="true">·</span>
        <a href="https://www.florian.bruniaux.com/" class="footer-meta-link" target="_blank" rel="noopener">Portfolio</a>
        <span class="footer-sep" aria-hidden="true">·</span>
        <a href="https://github.com/FlorianBruniaux" class="footer-meta-link" target="_blank" rel="noopener">GitHub</a>
      </div>
      <div class="footer-bottom-right">
        <p set:html={s.footerMadeBy} />
      </div>
    </div>

    <p class="footer-legal">
      {s.footerVersionLabel} {latest.version} · <time datetime={new Date(`${latest.date} 12:00 UTC`).toISOString().slice(0, 10)}>{releaseDate}</time>
    </p>

  </div>
</footer>

<style>
  /* Pilot footer (claude-code-ultimate-guide-landing@6b2e3b5 Footer.astro), itself the
     portfolio footer: charcoal hatched band (portfolio-system.css .site-footer-band), plain
     CTA above a rule, brand column, mono orange headings, ivory links that underline on
     hover, ecosystem behind a full-width disclosure, small bottom bar. */
  .footer {
    margin-top: var(--space-3xl);
    padding: 3rem 0 2.5rem;
  }

  /* CTA: no card, title, line and actions, then a rule. */
  .footer-cta {
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }
  .footer-cta-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .footer-cta-text h2 {
    margin: 0 0 0.5rem;
    color: var(--text-primary);
    font-size: 1.35rem;
    line-height: 1.2;
  }
  .footer-cta-text p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 1rem;
  }
  .footer-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .footer-lead-links { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; margin-bottom: 2rem; }
  .footer .footer-lead-links a { display: inline-flex; align-items: center; min-height: 44px; color: var(--text-primary); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .2em; }
  .footer .footer-lead-links a:hover { color: var(--accent); text-decoration-thickness: 2px; }

  /* Link grid: brand column, then the link columns. */
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .footer .footer-grid .footer-brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 32px;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
    text-decoration: none;
    transition: opacity 150ms ease;
  }
  .footer .footer-grid .footer-brand-link:hover { opacity: 0.8; text-decoration: none; }
  .footer-brand-icon {
    color: var(--action);
    font: 700 0.95rem/1 var(--font-mono);
  }
  .footer-brand-name {
    font: 700 1.35rem/1 var(--font-display);
    letter-spacing: -0.01em;
  }
  .footer-brand-text {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .footer-section h3 {
    margin: 0 0 0.75rem;
    color: var(--accent);
    font: 500 0.72rem/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .footer-section ul,
  .footer-ecosystem {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-section ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer .footer-section a,
  .footer .footer-ecosystem a {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    color: var(--text-primary);
    font-size: 0.875rem;
    line-height: 1.4;
    /* Link list (portfolio footer): plain at rest, underlined on hover and focus.
       !important beats the prose-link rule, which matches li > a.astro-*. */
    text-decoration: none !important;
  }
  .footer .footer-section a:is(:hover, :focus-visible),
  .footer .footer-ecosystem a:is(:hover, :focus-visible) {
    color: var(--accent);
    text-decoration: underline !important;
    text-underline-offset: 0.2em;
  }

  /* Ecosystem disclosure, as "Explore my ecosystem" in the portfolio footer. */
  .footer-ecosystem-toggle {
    margin-bottom: 2rem;
    border-block: 1px solid var(--border);
  }
  .footer-ecosystem-toggle > summary {
    display: flex;
    min-height: 56px;
    align-items: center;
    justify-content: space-between;
    color: var(--text-primary);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .footer-ecosystem-toggle > summary::-webkit-details-marker { display: none; }
  .footer-ecosystem-toggle > summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .footer-ecosystem-plus { color: var(--accent); font-size: 1.25rem; transition: transform 150ms ease; }
  .footer-ecosystem-toggle[open] .footer-ecosystem-plus { transform: rotate(45deg); }
  .footer-ecosystem {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0.5rem 1.5rem;
    padding-bottom: 1.25rem;
  }

  /* Bottom bar: small muted line, links in link colour. */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .footer-bottom-left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
  }
  .footer .footer-bottom .footer-meta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 32px;
    color: var(--text-muted);
    text-decoration: none;
  }
  .footer .footer-bottom .footer-meta-link:is(:hover, :focus-visible) { color: var(--accent); text-decoration: underline; }
  .footer-meta-text { color: var(--text-muted); font-size: 0.75rem; }
  .footer-sep { color: var(--text-muted); }
  .footer-bottom-right p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.75rem;
  }
  .footer .footer-bottom-right a {
    color: var(--accent);
    text-decoration: none;
  }
  .footer .footer-bottom-right a:is(:hover, :focus-visible) { color: var(--accent-hover); text-decoration: underline; }
  .footer-legal {
    margin: 0.75rem 0 0;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-ecosystem-plus,
    .footer .footer-grid .footer-brand-link { transition: none; }
  }

  /* Responsive */
  @media (max-width: 1100px) {
    .footer-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 768px) {
    .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer-brand { grid-column: 1 / -1; }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
