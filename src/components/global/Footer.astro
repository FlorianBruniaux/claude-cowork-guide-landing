---
import type { Lang } from '../../data/i18n'
import { t } from '../../data/i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const s = t(lang)

function isExternal(url: string): boolean {
  return url.startsWith('http://') || url.startsWith('https://')
}
---

<footer class="footer">
  <div class="container">

    <div class="footer-cta">
      <div class="footer-cta-inner">
        <div class="footer-cta-text">
          <h3>{s.footerCtaTitle}</h3>
          <p>{s.footerCtaText}</p>
        </div>
        <div class="footer-cta-actions">
          <a href="/guide/" class="btn btn-primary">{s.footerCtaCta}</a>
          <a
            href="https://github.com/FlorianBruniaux/claude-cowork-guide"
            class="btn btn-outline"
            target="_blank"
            rel="noopener"
          >
            <svg viewBox="0 0 16 16" fill="currentColor" width="14" height="14" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
                0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13
                -.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66
                .07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15
                -.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0
                1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82
                1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01
                1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </svg>
            GitHub
          </a>
        </div>
      </div>
    </div>

    <div class="footer-grid">
      {s.footerSections.map((section) => (
        <div class="footer-section">
          <h4>{section.title}</h4>
          <ul>
            {section.links.map((link) => (
              <li>
                {isExternal(link.url) ? (
                  <a href={link.url} target="_blank" rel="noopener">{link.text}</a>
                ) : (
                  <a href={link.url}>{link.text}</a>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="footer-bottom">
      <div class="footer-bottom-left">
        <a href="/sitemap-index.xml" class="footer-meta-link">Sitemap</a>
        <span class="footer-sep" aria-hidden="true">·</span>
        <a href="/rss.xml" class="footer-meta-link">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
            width="12" height="12" aria-hidden="true" style="vertical-align: -1px">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20
              C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0
              0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9
              9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
          </svg>
          RSS
        </a>
        <span class="footer-sep" aria-hidden="true">·</span>
        <span class="footer-meta-text">CC BY-SA 4.0</span>
      </div>
      <div class="footer-bottom-right">
        <p set:html={s.footerMadeBy} />
      </div>
    </div>

  </div>
</footer>

<style>
  .footer {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-subtle);
    padding: var(--space-3xl) 0 var(--space-xl);
  }

  /* CTA block */
  .footer-cta {
    border-radius: var(--radius-lg, 12px);
    border: 1px solid var(--border-subtle);
    border-top: 3px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 4%, var(--bg-primary));
    margin-bottom: var(--space-3xl);
    overflow: hidden;
  }
  .footer-cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    padding: var(--space-xl) var(--space-2xl);
    flex-wrap: wrap;
  }
  .footer-cta-text h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.375rem;
  }
  .footer-cta-text p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 0;
  }
  .footer-cta-actions {
    display: flex;
    gap: var(--space-sm);
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  /* Link grid */
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-lg) var(--space-xl);
    margin-bottom: var(--space-2xl);
  }
  .footer-section h4 {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-primary);
    margin: 0 0 var(--space-md);
  }
  .footer-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer-section a {
    color: var(--text-secondary);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.15s;
    line-height: 1.4;
  }
  .footer-section a:hover { color: var(--accent); }

  /* Bottom bar */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border-subtle);
  }
  .footer-bottom-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
  }
  .footer-meta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--text-tertiary);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-meta-link:hover { color: var(--accent); }
  .footer-meta-text {
    color: var(--text-tertiary);
    font-size: 0.8rem;
  }
  .footer-sep {
    color: var(--border-subtle);
  }
  .footer-bottom-right p {
    font-size: 0.8rem;
    color: var(--text-tertiary);
    margin: 0;
  }
  .footer-bottom-right a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-bottom-right a:hover { color: var(--accent); }

  /* Responsive */
  @media (max-width: 1100px) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 768px) {
    .footer-cta-inner { flex-direction: column; align-items: flex-start; }
    .footer-grid { grid-template-columns: repeat(2, 1fr); }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 480px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
