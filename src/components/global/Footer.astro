---
import type { Lang } from '../../data/i18n'
import { t } from '../../data/i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const s = t(lang)
---

<footer class="footer">
  <div class="container">
    <div class="footer-cta">
      <h3>{s.footerCtaTitle}</h3>
      <p>{s.footerCtaText}</p>
      <div class="footer-cta-actions">
        <a href="/guide/" class="btn btn-primary">{s.footerCtaCta}</a>
        <a
          href="https://github.com/FlorianBruniaux/claude-cowork-guide"
          class="btn btn-outline"
          target="_blank"
          rel="noopener"
        >
          <svg viewBox="0 0 16 16" fill="currentColor" width="14" height="14" aria-hidden="true"
            style="vertical-align: middle; margin-right: 0.3rem;">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
              0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13
              -.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66
              .07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15
              -.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0
              1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82
              1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01
              1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
          </svg>
          GitHub
        </a>
      </div>
    </div>

    <div class="footer-grid">
      {s.footerSections.map((section) => (
        <div class="footer-section">
          <h4>{section.title}</h4>
          <ul>
            {section.links.map((link) => (
              <li><a href={link.url} target="_blank" rel="noopener">{link.text}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="footer-bottom">
      <div class="footer-bottom-links">
        <a href="/sitemap-index.xml">Sitemap</a>
        <span aria-hidden="true">·</span>
        <a href="/rss.xml">RSS</a>
        <span aria-hidden="true">·</span>
        <span>CC BY-SA 4.0</span>
      </div>
      <p set:html={s.footerMadeBy} />
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border);
    padding: var(--space-3xl) 0 var(--space-xl);
  }

  .footer-cta {
    text-align: center;
    padding: var(--space-2xl);
    background: var(--bg-tertiary);
    border-radius: var(--border-radius-lg);
    margin-bottom: var(--space-3xl);
  }

  .footer-cta h3 {
    font-size: 1.5rem;
    margin-bottom: var(--space-sm);
  }

  .footer-cta p {
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
  }

  .footer-cta-actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-xl);
    margin-bottom: var(--space-2xl);
  }

  .footer-section h4 {
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: var(--space-md);
    color: var(--text-primary);
  }

  .footer-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-section li {
    margin-bottom: var(--space-sm);
  }

  .footer-section a {
    color: var(--text-secondary);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .footer-section a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    text-align: center;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .footer-bottom-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: var(--space-sm);
    font-size: 0.8rem;
  }

  .footer-bottom-links a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer-bottom-links a:hover {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>