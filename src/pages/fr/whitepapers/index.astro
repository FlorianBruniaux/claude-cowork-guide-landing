---
import Layout from '../../../layouts/Layout.astro'
import { WHITEPAPERS, TOTAL_PAGES, PDF_BASE_URL, API_URL } from '../../../data/whitepapers-data.ts'

const AUTHOR = {
  '@type': 'Person',
  name: 'Florian BRUNIAUX',
  url: 'https://github.com/FlorianBruniaux',
}

const title = 'Livres blancs — 17 Guides | Claude Cowork'
const description = `17 livres blancs, ${TOTAL_PAGES}+ pages, PDF. De la prise en main au déploiement équipe — guides pratiques pour TPE et PME françaises. WP-00 gratuit sans inscription.`

const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: 'Livres blancs Claude Cowork',
    description,
    url: 'https://cowork.bruniaux.com/fr/whitepapers/',
    inLanguage: 'fr',
    author: AUTHOR,
    hasPart: WHITEPAPERS.map(wp => ({
      '@type': 'Book',
      name: wp.titleFr,
      description: wp.subtitle,
      bookFormat: 'EBook',
      inLanguage: 'fr',
      url: 'https://cowork.bruniaux.com/fr/whitepapers/',
      author: AUTHOR,
      datePublished: wp.datePublished,
      numberOfPages: wp.pages,
      audience: {
        '@type': 'Audience',
        audienceType: wp.audience,
      },
    })),
  },
]

const profiles = [
  {
    label: 'Je débute avec Cowork',
    icon: '🚀',
    path: ['WP00', 'WP01', 'WP09'],
    desc: 'Point d\'entrée, prompts efficaces, puis sécurité des données.',
  },
  {
    label: 'Artisan / BTP',
    icon: '🔨',
    path: ['WP00', 'WP03', 'WP06'],
    desc: 'Démarrage, devis chantier, puis prospection clientèle.',
  },
  {
    label: 'Commerçant / Retail',
    icon: '🏪',
    path: ['WP00', 'WP04', 'WP07'],
    desc: 'Démarrage, calendrier commercial, puis communication.',
  },
  {
    label: 'Consultant / Indépendant',
    icon: '💼',
    path: ['WP05', 'WP06', 'WP08'],
    desc: 'ROI facturable, prospection clients, puis organisation.',
  },
  {
    label: 'Dirigeant qui déploie',
    icon: '👥',
    path: ['WP11', 'WP10', 'WP09'],
    desc: 'ROI d\'abord, formation équipe, puis sécurité des données.',
  },
  {
    label: 'Admin / Comptabilité',
    icon: '📊',
    path: ['WP02', 'WP08', 'WP01'],
    desc: 'Automatisation tâches admin, organisation, puis prompts.',
  },
]
---

<Layout lang="fr" title={title} description={description} jsonLd={jsonLd}>

  <!-- Hero -->
  <header class="page-hero">
    <div class="container">
      <div class="hero-label">Livres blancs & Guides PDF</div>
      <h1>Des guides terrain, pas des survols</h1>
      <p class="tagline">
        17 livres blancs couvrant chaque usage de Claude Cowork pour les TPE et PME françaises.
        Concrets, structurés, directement applicables. Tout en français.
      </p>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-num">17</span>
          <span class="stat-lbl">Livres blancs</span>
        </div>
        <div class="stat-sep" aria-hidden="true"></div>
        <div class="stat">
          <span class="stat-num">{TOTAL_PAGES}+</span>
          <span class="stat-lbl">Pages</span>
        </div>
        <div class="stat-sep" aria-hidden="true"></div>
        <div class="stat">
          <span class="stat-num">FR</span>
          <span class="stat-lbl">Langue</span>
        </div>
        <div class="stat-sep" aria-hidden="true"></div>
        <div class="stat">
          <span class="stat-num">PDF</span>
          <span class="stat-lbl">Format</span>
        </div>
      </div>
      <div class="hero-cta">
        <a href="#table" class="btn btn-primary">Voir tous les guides</a>
        <a href="#free" class="btn btn-secondary">Accès libre</a>
      </div>
    </div>
  </header>

  <div class="main-content container">

    <!-- Open access featured card -->
    <section id="free" class="section">
      <h2 class="section-heading">Sans inscription</h2>
      <p class="section-sub">Téléchargement direct — sans formulaire.</p>
      <div class="featured-grid">
        {WHITEPAPERS.filter(wp => !wp.gated).map(wp => (
          <div class="featured-card">
            <div class="featured-header">
              <span class="wp-num-badge">WP-{wp.num}</span>
              <span class="badge badge-free">Gratuit</span>
            </div>
            <h3 class="featured-title">{wp.titleFr}</h3>
            <p class="featured-sub">{wp.subtitle}</p>
            <div class="featured-meta">
              <span class="meta-pill">{wp.audience}</span>
              <span class="meta-pill">~{wp.pages}p</span>
            </div>
            <div class="featured-actions">
              <a
                href={`${PDF_BASE_URL}/${wp.hashedFileFr}`}
                target="_blank"
                rel="noopener"
                class="dl-btn dl-pdf"
                aria-label={`Télécharger ${wp.titleFr} PDF`}
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Télécharger PDF
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Complete table -->
    <section id="table" class="section">
      <h2 class="section-heading">Les 17 livres blancs</h2>
      <div class="wp-table">
        {WHITEPAPERS.map(wp => (
          <div class="wp-row" id={`wp-${wp.num}`}>
            <div class="wp-row-info">
              <div class="wp-row-header">
                <span class="wp-num-badge">WP-{wp.num}</span>
                {wp.badge && (
                  <span class={`badge ${wp.badge === 'Gratuit' ? 'badge-free' : wp.badge === 'Populaire' ? 'badge-popular' : 'badge-new'}`}>
                    {wp.badge}
                  </span>
                )}
                <span class="wp-audience">{wp.audience}</span>
                <span class="wp-pages">~{wp.pages}p</span>
              </div>
              <h3 class="wp-row-title">{wp.titleFr}</h3>
              <p class="wp-row-subtitle">{wp.subtitle}</p>
              <div class="wp-tags">
                {wp.tags.slice(0, 3).map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
            <div class="wp-row-actions">
              {wp.gated ? (
                <div class="gated-block" data-wp={wp.num} data-slug={`cw-${wp.slugFr}.fr`}>
                  <button
                    type="button"
                    class="get-btn"
                    data-wp={wp.num}
                    aria-expanded="false"
                    aria-controls={`form-${wp.num}`}
                  >
                    Recevoir le guide
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                  <div id={`form-${wp.num}`} class="inline-form hidden" role="region" aria-label={`Recevoir ${wp.titleFr}`}>
                    <form class="subscribe-form" data-wp={wp.num} data-slug={`cw-${wp.slugFr}.fr`}>
                      <input type="text" name="website" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
                      <div class="form-row">
                        <input type="text" name="firstname" placeholder="Prénom ou nom" required class="form-input" autocomplete="name" />
                        <input type="email" name="email" placeholder="Email" required class="form-input" autocomplete="email" />
                      </div>
                      <button type="submit" class="submit-btn">
                        <span class="submit-text">Envoyer dans ma boite mail</span>
                        <span class="submit-spinner hidden" aria-hidden="true">···</span>
                      </button>
                      <p class="form-note">Un seul email avec le lien de téléchargement. Pas de newsletter.</p>
                    </form>
                    <div class="form-success hidden" role="alert">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      Vérifiez votre boite mail — lien envoyé.
                    </div>
                    <div class="form-error hidden" role="alert">
                      Une erreur s'est produite. <a href="mailto:florian@bruniaux.com">Contactez-moi</a> pour recevoir le guide.
                    </div>
                  </div>
                </div>
              ) : (
                <div class="free-downloads">
                  <a href={`${PDF_BASE_URL}/${wp.hashedFileFr}`} target="_blank" rel="noopener" class="dl-btn dl-pdf">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    PDF gratuit
                  </a>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Reading paths -->
    <section id="parcours" class="section">
      <h2 class="section-heading">Par profil</h2>
      <p class="section-sub">Commencez par ce qui est utile pour vous. Ignorez le reste.</p>
      <div class="paths-grid">
        {profiles.map(p => (
          <div class="path-card">
            <div class="path-icon" aria-hidden="true">{p.icon}</div>
            <h3 class="path-label">{p.label}</h3>
            <p class="path-desc">{p.desc}</p>
            <div class="path-sequence">
              {p.path.map((ref, i) => {
                const num = ref.replace('WP', '')
                const wp = WHITEPAPERS.find(w => w.num === num)
                return wp ? (
                  <span class="path-step">
                    {i > 0 && <span class="path-arrow" aria-hidden="true">→</span>}
                    <a href={`#wp-${wp.num}`} class="path-link">{ref}</a>
                  </span>
                ) : null
              })}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="section faq-section">
      <h2 class="section-heading">FAQ</h2>
      <div class="faq-grid">
        <details class="faq-item">
          <summary class="faq-q">Quel format sont les livres blancs ?</summary>
          <p class="faq-a">PDF uniquement (rendu Quarto+Typst, palette Bold Guy). Optimisés pour lecture écran et impression A4.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Pourquoi certains demandent un email ?</summary>
          <p class="faq-a">Pas un paywall — tout est gratuit. WP-00 est accessible directement sans formulaire. Les autres demandent votre email pour envoyer le lien de téléchargement et vous prévenir quand une version révisée sort. Un seul email, pas de newsletter sauf si vous optez explicitement.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Quelle différence avec le guide principal ?</summary>
          <p class="faq-a">Le guide (workflows, prompts, référence) est la ressource complète — dense et navigable. Les livres blancs sont des récits structurés sur un seul sujet : meilleurs pour la lecture en continu, l'impression ou le partage avec un collègue.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Est-ce que les guides seront mis à jour ?</summary>
          <p class="faq-a">Oui. Chaque livre blanc a son propre numéro de version indépendant du guide. Votre lien email reste valide — il pointe toujours vers la version courante.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Y a-t-il des versions EN ?</summary>
          <p class="faq-a">Oui — les 17 livres blancs sont aussi disponibles en anglais. Les éditions françaises incluent les références spécifiques (URSSAF, Infogreffe, Pappers) tandis que les éditions anglaises s'adressent à un public international.</p>
        </details>
      </div>
    </section>

  </div>

</Layout>

<style>
  /* Layout */
  .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
  .main-content { padding-bottom: 5rem; }

  /* Hero */
  .page-hero {
    padding: 4rem 0 3rem;
    text-align: center;
    border-bottom: 1px solid var(--border);
    background: var(--bg-primary);
  }
  .hero-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }
  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
  }
  .tagline {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 580px;
    margin: 0 auto 2rem;
    line-height: 1.65;
  }
  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .stat { display: flex; flex-direction: column; align-items: center; padding: 0 1.5rem; }
  .stat-num { font-size: 1.4rem; font-weight: 800; color: var(--accent); line-height: 1.1; }
  .stat-lbl { font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 0.15rem; }
  .stat-sep { width: 1px; height: 2rem; background: var(--border); }
  .hero-cta { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; padding: 0.625rem 1.25rem; border-radius: 0.5rem; font-size: 0.9rem; font-weight: 600; text-decoration: none; cursor: pointer; transition: all 0.2s; }
  .btn-primary { background: var(--accent); color: #fff; }
  .btn-primary:hover { background: var(--accent-hover); }
  .btn-secondary { border: 1px solid var(--border); color: var(--text-secondary); background: var(--bg-secondary); }
  .btn-secondary:hover { color: var(--text-primary); border-color: var(--accent); }

  /* Sections */
  .section { padding: 3rem 0 1rem; }
  .section-heading { font-size: 1.5rem; font-weight: 800; color: var(--text-primary); margin: 0 0 0.4rem; }
  .section-sub { font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 1.75rem; }

  /* Badges */
  .badge {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
  }
  .badge-free { background: color-mix(in srgb, #22c55e 20%, transparent); color: #16a34a; }
  .badge-popular { background: color-mix(in srgb, var(--accent) 20%, transparent); color: var(--accent); }
  .badge-new { background: color-mix(in srgb, #6db3f2 20%, transparent); color: #2563eb; }

  .wp-num-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
  }

  /* Featured free cards */
  .featured-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem; }
  .featured-card {
    background: var(--surface-elevated);
    border: 1px solid var(--accent);
    border-radius: 0.75rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .featured-header { display: flex; align-items: center; gap: 0.5rem; }
  .featured-title { font-size: 1rem; font-weight: 700; color: var(--text-primary); margin: 0; }
  .featured-sub { font-size: 0.85rem; color: var(--text-secondary); margin: 0; line-height: 1.5; flex: 1; }
  .featured-meta { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .meta-pill {
    font-size: 0.7rem;
    background: var(--bg-tertiary);
    color: var(--text-muted);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--border);
  }
  .featured-actions { margin-top: 0.25rem; }
  .dl-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.4rem 0.85rem;
    border-radius: 0.4rem;
    text-decoration: none;
    transition: all 0.18s;
  }
  .dl-pdf {
    background: var(--accent);
    color: #fff;
  }
  .dl-pdf:hover { background: var(--accent-hover); }

  /* WP Table */
  .wp-table { display: flex; flex-direction: column; gap: 0; }
  .wp-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }
  .wp-row:last-child { border-bottom: none; }
  .wp-row-info { flex: 1; min-width: 0; }
  .wp-row-header { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.4rem; }
  .wp-audience { font-size: 0.72rem; color: var(--text-muted); }
  .wp-pages { font-size: 0.72rem; color: var(--text-muted); font-family: var(--font-mono); }
  .wp-row-title { font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin: 0 0 0.3rem; }
  .wp-row-subtitle { font-size: 0.83rem; color: var(--text-secondary); margin: 0 0 0.5rem; line-height: 1.5; }
  .wp-tags { display: flex; gap: 0.3rem; flex-wrap: wrap; }
  .tag {
    font-size: 0.65rem;
    background: var(--bg-tertiary);
    color: var(--text-muted);
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--border);
  }
  .wp-row-actions { min-width: 180px; display: flex; flex-direction: column; align-items: flex-end; gap: 0.5rem; }

  /* Gated form */
  .gated-block { display: flex; flex-direction: column; align-items: flex-end; gap: 0.5rem; width: 100%; }
  .get-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    border-radius: 0.4rem;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    cursor: pointer;
    transition: all 0.18s;
  }
  .get-btn:hover { background: var(--accent); color: #fff; }
  .inline-form {
    width: 100%;
    max-width: 300px;
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    padding: 0.85rem;
  }
  .inline-form.hidden { display: none; }
  .subscribe-form { display: flex; flex-direction: column; gap: 0.5rem; }
  .form-row { display: flex; gap: 0.4rem; }
  .form-input {
    flex: 1;
    min-width: 0;
    padding: 0.4rem 0.65rem;
    font-size: 0.8rem;
    border: 1px solid var(--border);
    border-radius: 0.35rem;
    background: var(--bg-primary);
    color: var(--text-primary);
    outline: none;
    transition: border-color 0.18s;
  }
  .form-input:focus { border-color: var(--accent); }
  .honeypot { display: none !important; }
  .submit-btn {
    width: 100%;
    padding: 0.45rem;
    font-size: 0.82rem;
    font-weight: 600;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 0.35rem;
    cursor: pointer;
    transition: background 0.18s;
    position: relative;
  }
  .submit-btn:hover { background: var(--accent-hover); }
  .submit-btn:disabled { opacity: 0.6; cursor: not-allowed; }
  .hidden { display: none !important; }
  .form-note { font-size: 0.72rem; color: var(--text-muted); margin: 0; text-align: center; }
  .form-success {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #16a34a;
    padding: 0.5rem 0;
  }
  .form-error {
    font-size: 0.8rem;
    color: var(--status-danger, #ef4444);
    padding: 0.35rem 0;
    text-align: center;
  }
  .form-error a { color: inherit; }

  /* Free direct download */
  .free-downloads { display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: flex-end; }

  /* Reading paths */
  .paths-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; }
  .path-card {
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    border-radius: 0.65rem;
    padding: 1rem;
  }
  .path-icon { font-size: 1.4rem; margin-bottom: 0.4rem; }
  .path-label { font-size: 0.85rem; font-weight: 700; color: var(--text-primary); margin: 0 0 0.25rem; }
  .path-desc { font-size: 0.78rem; color: var(--text-secondary); margin: 0 0 0.6rem; line-height: 1.4; }
  .path-sequence { display: flex; align-items: center; gap: 0.2rem; flex-wrap: wrap; }
  .path-step { display: flex; align-items: center; gap: 0.2rem; }
  .path-arrow { color: var(--text-muted); font-size: 0.7rem; }
  .path-link {
    font-size: 0.72rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--accent);
    text-decoration: none;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
  }
  .path-link:hover { background: color-mix(in srgb, var(--accent) 20%, transparent); }

  /* FAQ */
  .faq-section { border-top: 1px solid var(--border); }
  .faq-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 0; }
  .faq-item {
    border-bottom: 1px solid var(--border);
    padding: 0;
  }
  .faq-item:last-child { border-bottom: none; }
  .faq-q {
    padding: 0.85rem 1.25rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q::after { content: '+'; color: var(--accent); font-size: 1rem; flex-shrink: 0; }
  details[open] .faq-q::after { content: '−'; }
  .faq-a { padding: 0 1.25rem 1rem; font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6; margin: 0; }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-stats { gap: 0; }
    .stat { padding: 0 1rem; }
    .stat-num { font-size: 1.2rem; }
    .wp-row { flex-direction: column; gap: 1rem; }
    .wp-row-actions { align-items: flex-start; min-width: auto; width: 100%; }
    .inline-form { max-width: 100%; }
    .form-row { flex-direction: column; }
    .featured-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .stat-sep { display: none; }
    .stat { padding: 0.5rem 0.75rem; }
  }
</style>

<script define:vars={{ apiUrl: API_URL }}>
  // Restore saved contact details into a form
  function prefillContactFields(form) {
    try {
      const name = localStorage.getItem('cowork-contact-name')
      const email = localStorage.getItem('cowork-contact-email')
      if (name) form.querySelector('[name="firstname"]').value = name
      if (email) form.querySelector('[name="email"]').value = email
    } catch {}
  }

  // Toggle inline form
  document.querySelectorAll('.get-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const wpNum = btn.dataset.wp
      const form = document.getElementById(`form-${wpNum}`)
      if (!form) return
      const isOpen = btn.getAttribute('aria-expanded') === 'true'
      btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true')
      form.classList.toggle('hidden', isOpen)
      if (!isOpen) {
        prefillContactFields(form)
        const nameInput = form.querySelector('[name="firstname"]')
        ;(nameInput?.value ? form.querySelector('[name="email"]') : nameInput)?.focus()
      }
    })
  })

  // Capture UTM params
  const urlParams = new URLSearchParams(window.location.search)
  const utmSource = urlParams.get('utm_source') || document.referrer || 'direct'
  const utmCampaign = urlParams.get('utm_campaign') || null

  // Handle form submission
  document.querySelectorAll('.subscribe-form').forEach(form => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const wpNum = form.dataset.wp
      const slug = form.dataset.slug

      const honeypot = form.querySelector('[name="website"]')?.value
      if (honeypot) return

      const email = form.querySelector('[name="email"]')?.value
      const firstName = form.querySelector('[name="firstname"]')?.value

      try {
        if (firstName) localStorage.setItem('cowork-contact-name', firstName)
        if (email) localStorage.setItem('cowork-contact-email', email)
      } catch {}

      const submitBtn = form.querySelector('.submit-btn')
      const submitText = form.querySelector('.submit-text')
      const submitSpinner = form.querySelector('.submit-spinner')
      const successMsg = form.parentElement?.querySelector('.form-success')

      if (submitBtn) submitBtn.disabled = true
      submitText?.classList.add('hidden')
      submitSpinner?.classList.remove('hidden')

      try {
        const res = await fetch(apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            firstName,
            filename: slug,
            website: '',
            source: utmSource,
            ...(utmCampaign && { utmCampaign }),
          }),
        })

        if (!res.ok) throw new Error(`API ${res.status}`)

        form.classList.add('hidden')
        successMsg?.classList.remove('hidden')
        try { localStorage.setItem('cowork-subscriber', '1') } catch {}
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'ebook_subscribe', {
            guide: slug,
            format: 'pdf',
            source: utmSource,
            ...(utmCampaign && { campaign: utmCampaign }),
          })
        }
      } catch (err) {
        form.classList.add('hidden')
        const errorMsg = form.parentElement?.querySelector('.form-error')
        errorMsg?.classList.remove('hidden')
        console.warn('Subscribe API error:', err)
      } finally {
        if (submitBtn) submitBtn.disabled = false
        submitText?.classList.remove('hidden')
        submitSpinner?.classList.add('hidden')
      }
    })
  })
</script>
