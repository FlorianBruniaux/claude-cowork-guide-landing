---
import Layout from '../../layouts/Layout.astro'
import ChapterLabel from '../../components/global/ChapterLabel.astro'
import { t } from '../../data/i18n'
import { glossaryTerms, groupByLetter, categoryColors } from '../../data/glossary-data'

const lang = 'en'
const s = t(lang)

const grouped = groupByLetter(glossaryTerms)
const letters = Array.from(grouped.keys()).sort()
const totalTerms = glossaryTerms.length

const jsonLd = [
  {
    '@type': 'DefinedTermSet',
    name: 'Claude Cowork Guide Glossary',
    url: 'https://cowork.bruniaux.com/glossary/',
    hasDefinedTerm: glossaryTerms.map(t => ({
      '@type': 'DefinedTerm',
      name: t.term,
      description: t.definition,
    })),
  },
]
---

<Layout
  lang={lang}
  title={s.glossaryMetaTitle}
  description={s.glossaryMetaDescription}
  jsonLd={jsonLd}
>
  <div class="page-hero">
    <div class="container">
      <a href="/" class="back-link">{s.glossaryBackHome}</a>
      <h1>{s.glossaryHeroTitle}</h1>
      <p class="hero-subtitle">{s.glossaryHeroSubtitle}</p>
      <div class="glossary-meta">
        <span class="glossary-count">{totalTerms} terms</span>
        <nav class="alpha-nav" aria-label="Jump to letter">
          {letters.map(letter => (
            <a href={`#letter-${letter}`} class="alpha-link">{letter}</a>
          ))}
        </nav>
      </div>
    </div>
  </div>

  <section class="band band-base glossary-band">
  <div class="container">
    <ChapterLabel number="01" label={`${totalTerms} terms`} />
    {letters.map(letter => {
      const terms = grouped.get(letter)!
      return (
        <div class="letter-group" id={`letter-${letter}`}>
          <h2 class="letter-heading">
            <span class="letter-char">{letter}</span>
            <span class="letter-count">{terms.length}</span>
          </h2>
          <div class="terms-list brand-card">
            {terms.map(term => (
              <div class="term-row" data-cat={term.category}>
                <div class="term-left">
                  <h3 class="term-name">
                    {term.link
                      ? <a href={term.link} class="term-link" target={term.link.startsWith('http') ? '_blank' : undefined} rel={term.link.startsWith('http') ? 'noopener noreferrer' : undefined}>{term.term}</a>
                      : term.term
                    }
                  </h3>
                  <span class={`badge ${categoryColors[term.category]}`}>{term.category}</span>
                </div>
                <p class="term-def">{term.definition}</p>
              </div>
            ))}
          </div>
        </div>
      )
    })}

  </div>
  </section>

  <section class="band band-ink section-wallpaper glossary-cta-band">
  <div class="container">
    <div class="glossary-cta">
      <p>{s.glossaryContributeText} <a href="https://github.com/FlorianBruniaux/claude-cowork-guide/issues" target="_blank" rel="noopener noreferrer" class="cta-link">{s.glossaryContributeLink}</a></p>
    </div>
  </div>
  </section>
</Layout>

<style>
  .page-hero { padding: 4rem 0 3rem; }
  .page-hero h1 { margin: var(--space-sm) 0; }
  .back-link { display: inline-block; font-size: 0.9rem; color: var(--accent); margin-bottom: var(--space-md); }
  .hero-subtitle { color: var(--text-secondary); font-size: 1.1rem; margin-bottom: var(--space-lg); }

  .glossary-meta { display: flex; align-items: center; gap: var(--space-lg); flex-wrap: wrap; }

  .glossary-count {
    font: 500 0.8rem/1.4 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-primary);
    border: 1px solid var(--border);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-control);
    white-space: nowrap;
  }

  .alpha-nav { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .page-hero .alpha-nav .alpha-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    border-radius: var(--radius-control);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
    border: 1px solid var(--border);
    text-decoration: none;
    transition: color 120ms ease, border-color 120ms ease, background-color 120ms ease;
  }
  .page-hero .alpha-nav .alpha-link:hover {
    color: var(--bg-primary);
    border-color: var(--text-primary);
    background: var(--text-primary);
  }
  .page-hero .alpha-nav .alpha-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .glossary-band { padding: var(--space-3xl) 0 var(--space-4xl); }

  .letter-group { margin-bottom: var(--space-2xl); scroll-margin-top: 5rem; }
  .letter-group:last-child { margin-bottom: 0; }

  .letter-heading {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin: 0;
    padding: 0.5rem 0.9rem;
    font-size: inherit;
    background: var(--band-ink-background);
    border-left: 3px solid var(--action);
    border-radius: var(--radius-control) var(--radius-control) 0 0;
  }
  .letter-char { font-family: var(--font-display); font-size: 1.6rem; font-weight: 700; color: #f97316; line-height: 1; }
  .letter-count {
    font: 500 0.7rem/1.4 var(--font-mono);
    color: #f5f0e6;
    background: var(--band-ink-surface);
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-control);
    margin-left: auto;
  }

  .terms-list { overflow: hidden; border-top-left-radius: 0; border-top-right-radius: 0; }

  .term-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 0 var(--space-xl);
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid var(--border);
    border-left: 3px solid transparent;
    align-items: start;
  }
  .term-row:last-child { border-bottom: none; }
  .term-row:hover { background: var(--bg-secondary); }

  .term-row[data-cat="Cowork"]    { border-left-color: var(--action); }
  .term-row[data-cat="AI"]        { border-left-color: #a855f7; }
  .term-row[data-cat="Workflow"]  { border-left-color: #10b981; }
  .term-row[data-cat="Security"]  { border-left-color: #ef4444; }
  .term-row[data-cat="Ecosystem"] { border-left-color: #f59e0b; }

  .term-left { display: flex; flex-direction: column; gap: var(--space-xs); }
  .term-name { font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin: 0; line-height: 1.35; font-family: inherit; }

  .terms-list .term-link { color: var(--accent); }

  .badge {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-control);
    white-space: nowrap;
    width: fit-content;
  }
  .badge-cowork    { background: color-mix(in srgb, var(--accent) 15%, transparent); color: var(--accent); }
  .badge-ai        { background: #ede9fe; color: #5b21b6; }
  .badge-workflow  { background: #d1fae5; color: #065f46; }
  .badge-security  { background: #fee2e2; color: #991b1b; }
  .badge-ecosystem { background: #fef3c7; color: #92400e; }

  :global([data-theme="dark"]) .badge-ai        { background: rgba(88,28,135,0.4); color: #c4b5fd; }
  :global([data-theme="dark"]) .badge-workflow  { background: rgba(6,78,59,0.4);   color: #6ee7b7; }
  :global([data-theme="dark"]) .badge-security  { background: rgba(127,29,29,0.4); color: #fca5a5; }
  :global([data-theme="dark"]) .badge-ecosystem { background: rgba(120,53,15,0.4); color: #fcd34d; }

  .term-def { font-size: 0.9rem; color: var(--text-secondary); margin: 0; line-height: 1.7; }

  .glossary-cta-band { padding: var(--space-2xl) 0; }
  .glossary-cta { text-align: center; color: var(--text-primary); font-size: 1rem; }
  .glossary-cta p { margin: 0; }
  .glossary-cta .cta-link { color: var(--accent); font-weight: 600; }

  @media (max-width: 640px) {
    .term-row { grid-template-columns: 1fr; gap: var(--space-xs); }
    .glossary-meta { flex-direction: column; align-items: flex-start; }
  }
</style>
