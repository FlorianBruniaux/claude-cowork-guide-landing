---
import Layout from '../../layouts/Layout.astro'
import { t } from '../../data/i18n'
import { glossaryTerms, groupByLetter, categoryColors } from '../../data/glossary-data'

const lang = 'en'
const s = t(lang)

const grouped = groupByLetter(glossaryTerms)
const letters = Array.from(grouped.keys()).sort()
const totalTerms = glossaryTerms.length

const jsonLd = [
  {
    '@type': 'DefinedTermSet',
    name: 'Claude Cowork Guide Glossary',
    url: 'https://cowork.bruniaux.com/glossary/',
    hasDefinedTerm: glossaryTerms.map(t => ({
      '@type': 'DefinedTerm',
      name: t.term,
      description: t.definition,
    })),
  },
]
---

<Layout
  lang={lang}
  title={s.glossaryMetaTitle}
  description={s.glossaryMetaDescription}
  jsonLd={jsonLd}
>
  <div class="page-hero">
    <div class="container">
      <a href="/" class="back-link">{s.glossaryBackHome}</a>
      <h1>{s.glossaryHeroTitle}</h1>
      <p class="hero-subtitle">{s.glossaryHeroSubtitle}</p>
      <div class="glossary-meta">
        <span class="glossary-count">{totalTerms} terms</span>
        <nav class="alpha-nav" aria-label="Jump to letter">
          {letters.map(letter => (
            <a href={`#letter-${letter}`} class="alpha-link">{letter}</a>
          ))}
        </nav>
      </div>
    </div>
  </div>

  <div class="container glossary-page">
    {letters.map(letter => {
      const terms = grouped.get(letter)!
      return (
        <div class="letter-group" id={`letter-${letter}`}>
          <div class="letter-heading">
            <span class="letter-char">{letter}</span>
            <span class="letter-count">{terms.length}</span>
          </div>
          <div class="terms-list">
            {terms.map(term => (
              <div class="term-row" data-cat={term.category}>
                <div class="term-left">
                  <h3 class="term-name">
                    {term.link
                      ? <a href={term.link} class="term-link" target={term.link.startsWith('http') ? '_blank' : undefined} rel={term.link.startsWith('http') ? 'noopener noreferrer' : undefined}>{term.term}</a>
                      : term.term
                    }
                  </h3>
                  <span class={`badge ${categoryColors[term.category]}`}>{term.category}</span>
                </div>
                <p class="term-def">{term.definition}</p>
              </div>
            ))}
          </div>
        </div>
      )
    })}

    <div class="glossary-cta">
      <p>{s.glossaryContributeText} <a href="https://github.com/FlorianBruniaux/claude-cowork-guide/issues" target="_blank" rel="noopener noreferrer" class="cta-link">{s.glossaryContributeLink}</a></p>
    </div>
  </div>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--surface-elevated) 0%, var(--bg-primary) 100%);
    border-bottom: 1px solid var(--border);
    padding: calc(var(--space-3xl) + 3.5rem) var(--space-lg) var(--space-2xl);
  }

  .back-link {
    display: inline-block;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: var(--space-md);
    transition: color var(--transition-fast);
  }
  .back-link:hover { color: var(--accent); }

  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-sm);
  }

  .hero-subtitle {
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin-bottom: var(--space-lg);
  }

  .glossary-meta {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .glossary-count {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    padding: 0.25rem 0.75rem;
    border-radius: 99px;
    white-space: nowrap;
  }

  .alpha-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .alpha-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    text-decoration: none;
    transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
  }
  .alpha-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .glossary-page {
    padding: var(--space-3xl) var(--space-lg) var(--space-4xl);
  }

  .letter-group {
    margin-bottom: var(--space-2xl);
    scroll-margin-top: 5rem;
  }

  .letter-heading {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
    padding: 0.5rem 0.9rem;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border-left: 3px solid var(--accent);
    border-radius: 0 6px 6px 0;
  }

  .letter-char {
    font-size: 1.1rem;
    font-weight: 900;
    color: var(--accent);
    line-height: 1;
  }

  .letter-count {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bg-tertiary);
    padding: 0.1rem 0.4rem;
    border-radius: 99px;
    margin-left: auto;
  }

  .terms-list {
    border: 1px solid var(--border);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
  }

  .term-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 0 var(--space-xl);
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid var(--border);
    border-left: 3px solid transparent;
    align-items: start;
    transition: background var(--transition-fast);
  }
  .term-row:last-child { border-bottom: none; }
  .term-row:nth-child(even) { background: color-mix(in srgb, currentColor 3%, transparent); }
  .term-row:hover { background: color-mix(in srgb, var(--accent) 6%, transparent); }

  .term-row[data-cat="Cowork"]    { border-left-color: var(--accent); }
  .term-row[data-cat="AI"]        { border-left-color: #a855f7; }
  .term-row[data-cat="Workflow"]  { border-left-color: #10b981; }
  .term-row[data-cat="Security"]  { border-left-color: #ef4444; }
  .term-row[data-cat="Ecosystem"] { border-left-color: #f59e0b; }

  .term-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .term-name {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.35;
    font-family: inherit;
  }

  .term-link {
    color: var(--accent);
    text-decoration: none;
  }
  .term-link:hover { text-decoration: underline; }

  .badge {
    display: inline-block;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    white-space: nowrap;
    width: fit-content;
  }

  .badge-cowork    { background: color-mix(in srgb, var(--accent) 15%, transparent); color: var(--accent); }
  .badge-ai        { background: #ede9fe; color: #5b21b6; }
  .badge-workflow  { background: #d1fae5; color: #065f46; }
  .badge-security  { background: #fee2e2; color: #991b1b; }
  .badge-ecosystem { background: #fef3c7; color: #92400e; }

  :global([data-theme="dark"]) .badge-ai        { background: rgba(88,28,135,0.4); color: #c4b5fd; }
  :global([data-theme="dark"]) .badge-workflow  { background: rgba(6,78,59,0.4);   color: #6ee7b7; }
  :global([data-theme="dark"]) .badge-security  { background: rgba(127,29,29,0.4); color: #fca5a5; }
  :global([data-theme="dark"]) .badge-ecosystem { background: rgba(120,53,15,0.4); color: #fcd34d; }

  .term-def {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.7;
  }

  .glossary-cta {
    text-align: center;
    padding: var(--space-xl) 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
    border-top: 1px solid var(--border);
    margin-top: var(--space-xl);
  }

  .cta-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }
  .cta-link:hover { text-decoration: underline; }

  @media (max-width: 640px) {
    .term-row {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }
    .glossary-meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
