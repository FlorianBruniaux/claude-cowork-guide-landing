---
import Layout from '../../layouts/Layout.astro'
import ChapterLabel from '../../components/global/ChapterLabel.astro'
import { t } from '../../data/i18n'
import { GUIDE_ID, PERSON_ID } from '../../data/site-schema'
import { releases } from '../../data/releases'

const lang = 'en'
const s = t(lang)
const initiallyVisible = releases.filter(r => r.initiallyVisible)
const hidden = releases.filter(r => !r.initiallyVisible)

function stripHtml(str: string) {
  return str.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').trim()
}

function parseDate(dateStr: string): string {
  return new Date(dateStr).toISOString().split('T')[0]
}

const latestRelease = releases.find(r => r.latest) ?? releases[0]

// Same cards, grouped into bands: latest, recent versions, then the ones behind the toggle.
const releaseGroups = [
  { key: 'latest', band: 'band-base', timeline: 'releases-timeline-latest', label: s.releasesLatestBadge, items: [latestRelease] },
  { key: 'recent', band: 'band-ink section-wallpaper', timeline: '', label: s.releasesHeroTitle, items: releases.filter(r => r !== latestRelease && r.initiallyVisible) },
  { key: 'older', band: 'band-paper section-wallpaper releases-older', timeline: '', label: '', items: releases.filter(r => r !== latestRelease && !r.initiallyVisible) },
].filter(g => g.items.length > 0)

const releasesJsonLd = [
  {
    '@type': 'WebPage',
    '@id': 'https://cowork.bruniaux.com/releases/#page',
    name: s.releasesMetaTitle,
    description: s.releasesMetaDescription,
    url: 'https://cowork.bruniaux.com/releases/',
    inLanguage: 'en',
    dateModified: parseDate(latestRelease.date),
    mainEntity: {
      '@type': 'ItemList',
      name: 'Claude Cowork Guide Versions',
      numberOfItems: releases.length,
      itemListElement: releases.map((release, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'CreativeWork',
          name: `Claude Cowork Guide ${release.version}`,
          version: release.version.replace('v', ''),
          description: release.featuredLabel
            ? stripHtml(release.featuredLabel).replace(/^[^\p{L}\p{N}]+/u, '').trim()
            : stripHtml(release.highlights[0] ?? ''),
          datePublished: parseDate(release.date),
          url: 'https://cowork.bruniaux.com/releases/',
          author: { '@id': PERSON_ID },
          isPartOf: { '@id': GUIDE_ID },
        },
      })),
    },
  },
]
---

<Layout
  lang={lang}
  title={s.releasesMetaTitle}
  description={s.releasesMetaDescription}
  jsonLd={releasesJsonLd}
>
  <div class="page-hero">
    <div class="container">
      <a href="/" class="back-link">{s.releasesBackHome}</a>
      <h1>{s.releasesHeroTitle}</h1>
      <p class="hero-subtitle">{s.releasesHeroSubtitle}</p>
      <div class="releases-meta">
        <span class="releases-count">{releases.length} versions</span>
        <a href="https://github.com/FlorianBruniaux/claude-cowork-guide" class="btn btn-secondary btn-sm" target="_blank" rel="noopener">{s.releasesViewGitHub}</a>
      </div>
    </div>
  </div>

  {releaseGroups.map((group, groupIndex) => (
    <section class={`band ${group.band} releases-band`}>
      <div class="container">
        {group.label && <ChapterLabel number={String(groupIndex + 1).padStart(2, '0')} label={group.label} />}
        <div class={`releases-timeline ${group.timeline}`} id={groupIndex === 0 ? 'releases-timeline' : undefined}>
          {group.items.map((release) => (
        <div
          class:list={['release-card', 'brand-card', { 'release-latest': release.latest, 'release-hidden': !release.initiallyVisible }]}
          data-index={releases.indexOf(release)}
        >
          {release.latest && <span class="latest-badge">{s.releasesLatestBadge}</span>}
          {release.featured && release.featuredLabel && (
            <span class="featured-label" set:html={release.featuredLabel} />
          )}
          <div class="release-header">
            <span class="release-version">{release.version}</span>
            <span class="release-date">{release.date}</span>
          </div>
          <ul class="release-highlights">
            {release.highlights.map(h => <li set:html={h} />)}
          </ul>
          {release.breaking && release.breaking.length > 0 && (
            <div class="release-breaking">
              <strong>⚠️ Breaking changes:</strong>
              <ul>
                {release.breaking.map(b => <li set:html={b} />)}
              </ul>
            </div>
          )}
        </div>
          ))}
        </div>
        {group.key === 'older' && (
      <div class="releases-toggle">
        <button id="toggle-btn" class="btn btn-secondary">
          {s.releasesShowAll} ({hidden.length} more)
        </button>
      </div>
        )}
      </div>
    </section>
  ))}
</Layout>

<script>
  const btn = document.getElementById('toggle-btn')
  const hidden = document.querySelectorAll<HTMLElement>('.release-hidden')
  let expanded = false

  btn?.addEventListener('click', () => {
    expanded = !expanded
    hidden.forEach(el => {
      el.style.display = expanded ? 'flex' : 'none'
    })
    if (btn) {
      btn.textContent = expanded
        ? btn.dataset.less ?? 'Show less'
        : btn.dataset.more ?? 'Show all'
    }
  })
</script>

<style>
  .page-hero { padding: 4rem 0 3rem; }
  .page-hero h1 { margin: var(--space-sm) 0; }
  .back-link { display: inline-block; font-size: 0.9rem; color: var(--accent); margin-bottom: var(--space-md); }

  .hero-subtitle { color: var(--text-secondary); font-size: 1.1rem; margin-bottom: var(--space-lg); }

  .releases-meta { display: flex; align-items: center; gap: var(--space-md); flex-wrap: wrap; }

  .releases-count {
    font: 500 0.8rem/1.4 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-primary);
    border: 1px solid var(--border);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-control);
  }

  .btn-sm { padding: 0.35rem 0.85rem; font-size: 0.85rem; min-height: 44px; }

  .releases-band { padding: var(--space-3xl) 0; }
  .releases-band.releases-older { padding: var(--space-2xl) 0 var(--space-3xl); }
  .releases-older .releases-toggle { margin-top: var(--space-lg); }

  .releases-timeline {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-lg);
  }
  .releases-timeline-latest { grid-template-columns: 1fr; }

  .release-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-lg);
    position: relative;
  }

  .release-latest { border-top: 3px solid var(--action); }
  .release-latest .release-version { font-size: 1.6rem; }
  .release-latest .release-highlights li { font-size: 1rem; }

  .release-hidden { display: none; }

  .latest-badge {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    background: var(--action);
    color: var(--action-ink);
    font: 600 0.7rem/1.4 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-control);
  }

  .featured-label { display: inline-block; font-size: 0.8rem; font-weight: 600; color: var(--accent); margin-bottom: var(--space-sm); }

  .release-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border);
  }

  .release-version { font-family: var(--font-display); font-size: 1.3rem; font-weight: 700; color: var(--text-primary); }
  .release-date { font: 500 0.8rem/1.4 var(--font-mono); color: var(--text-muted); }

  .release-highlights { list-style: none; padding: 0; margin: 0; flex: 1; }
  .release-highlights li {
    position: relative;
    padding-left: var(--space-lg);
    margin-bottom: var(--space-sm);
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .release-highlights li::before { content: '→'; position: absolute; left: 0; color: var(--accent); }
  .release-highlights li:last-child { margin-bottom: 0; }

  .release-highlights :global(code) {
    background: var(--bg-tertiary);
    color: var(--accent);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-control);
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .release-breaking {
    margin-top: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    background: var(--bg-tertiary);
    border-left: 3px solid var(--status-danger, #ef4444);
    border-radius: 0 var(--radius-control) var(--radius-control) 0;
    font-size: 0.875rem;
  }
  .release-breaking ul { list-style: disc; padding-left: var(--space-lg); margin-top: var(--space-xs); color: var(--text-secondary); }

  .releases-toggle { text-align: center; }
  .releases-toggle .btn { min-height: 44px; }

  @media (max-width: 640px) {
    .releases-timeline { grid-template-columns: 1fr; }
  }
</style>
