---
import ChapterLabel from '../../components/global/ChapterLabel.astro'
import Layout from '../../layouts/Layout.astro'
import { t } from '../../data/i18n'
import { PROMPT_CATEGORIES } from '../../data/prompts-data'

const lang = 'en'
const s = t(lang)

const bandSurfaces = ['band-base', 'band-paper section-wallpaper', 'band-ink section-wallpaper', 'band-base']

const allPrompts = PROMPT_CATEGORIES.flatMap(cat => cat.prompts)

const promptsJsonLd = [
  {
    '@type': 'CollectionPage',
    name: s.promptsMetaTitle,
    description: s.promptsMetaDescription,
    url: 'https://cowork.bruniaux.com/prompts/',
    inLanguage: 'en',
    mainEntity: {
      '@type': 'ItemList',
      name: 'Claude Cowork Prompts',
      numberOfItems: allPrompts.length,
      itemListElement: allPrompts.map((prompt, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'CreativeWork',
          name: prompt.title,
          url: `https://cowork.bruniaux.com/prompts/#${prompt.id}`,
          inLanguage: 'en',
        },
      })),
    },
  },
]
---

<Layout
  lang={lang}
  title={s.promptsMetaTitle}
  description={s.promptsMetaDescription}
  jsonLd={promptsJsonLd}
>
  <div class="page-hero">
    <div class="container">
      <a href="/" class="back-link">{s.promptsBackHome}</a>
      <h1>{s.promptsTitle}</h1>
      <p class="hero-subtitle">{s.promptsSubtitle}</p>
      <p class="hero-note">{s.promptsHeroNote}</p>
    </div>
  </div>

    {PROMPT_CATEGORIES.map((category, i) => (
      <section class={`prompt-category band ${bandSurfaces[i % bandSurfaces.length]}`} id={category.id}>
        <div class="container">
          <ChapterLabel number={String(i + 1).padStart(2, '0')} label={category.title} />
        <div class="category-header">
          <div class="category-title-row">
            <span class="category-icon">{category.icon}</span>
            <div>
              <h2 class="category-title">{category.title}</h2>
              <p class="category-desc">{category.desc}</p>
            </div>
          </div>
          <div class="category-meta">
            <span class="prompt-count">{category.count} prompts</span>
            <a href={category.guideUrl} target="_blank" rel="noopener" class="btn btn-secondary btn-sm">
              {s.promptsSeeAll}
            </a>
          </div>
        </div>

        <div class="prompts-list">
          {category.prompts.map(prompt => (
            <div class="prompt-card brand-card" id={prompt.id}>
              <div class="prompt-card-header">
                <h3 class="prompt-title">{prompt.title}</h3>
                <button
                  class="copy-btn"
                  data-code={prompt.code}
                  aria-label={`Copy prompt: ${prompt.title}`}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round" width="14" height="14" aria-hidden="true">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                  </svg>
                  {s.promptExampleCopy}
                </button>
              </div>
              <pre class="prompt-code"><code>{prompt.code}</code></pre>
            </div>
          ))}
        </div>
        </div>
      </section>
    ))}

    <section class="band band-accent section-wallpaper prompts-cta-band">
    <div class="container">
    <div class="prompts-footer-cta brand-card">
      <p>These are featured examples from each category. The full guide contains all 70 prompts.</p>
      <a
        href="https://github.com/FlorianBruniaux/claude-cowork-guide/tree/main/prompts"
        target="_blank"
        rel="noopener"
        class="btn btn-primary"
      >
        View All Prompts on GitHub →
      </a>
    </div>
    </div>
    </section>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const code = btn.dataset.code ?? ''
      try {
        await navigator.clipboard.writeText(code)
        const original = btn.innerHTML
        btn.textContent = 'Copied!'
        btn.classList.add('copied')
        setTimeout(() => {
          btn.innerHTML = original
          btn.classList.remove('copied')
        }, 2000)
      } catch {
        // Fallback for older browsers
        const el = document.createElement('textarea')
        el.value = code
        el.style.position = 'absolute'
        el.style.left = '-9999px'
        document.body.appendChild(el)
        el.select()
        document.execCommand('copy')
        document.body.removeChild(el)
        btn.textContent = 'Copied!'
        btn.classList.add('copied')
        setTimeout(() => btn.classList.remove('copied'), 2000)
      }
    })
  })
</script>

<style>
  .back-link {
    font-size: 0.875rem;
    color: var(--accent);
    text-decoration: none;
    opacity: 1;
  }
  .back-link:hover, .back-link:focus-visible { text-decoration-thickness: 2px; }
  .hero-subtitle {
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin: 0 0 var(--space-sm);
  }
  .hero-note {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
  }

  .prompt-category, .prompts-cta-band { padding: clamp(3rem, 6vw, 4.5rem) 0; }

  .prompt-category {
    scroll-margin-top: 4rem;
  }

  .category-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }
  .category-title-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
  }
  .category-icon {
    font-size: 2rem;
    line-height: 1;
    margin-top: 0.125rem;
  }
  .category-title {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.25rem;
  }
  .category-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin: 0;
  }
  .category-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-shrink: 0;
  }
  .prompt-count {
    font-size: 0.8rem;
    color: var(--text-muted);
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .prompts-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .prompt-card {
    overflow: hidden;
  }
  .prompt-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-tertiary, color-mix(in srgb, var(--bg-secondary) 50%, var(--bg-primary)));
  }
  .prompt-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }
  .copy-btn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    padding: 0.25rem 0.875rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-primary);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
    white-space: nowrap;
  }
  .copy-btn:hover {
    background: var(--bg-tertiary);
    border-color: var(--text-primary);
    color: var(--text-primary);
  }
  .copy-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .copy-btn.copied {
    background: var(--text-primary);
    border-color: var(--text-primary);
    color: var(--bg-primary);
  }
  .prompt-code {
    margin: 0;
    padding: var(--space-md);
    font-size: 0.8125rem;
    line-height: 1.6;
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--text-primary);
    background: transparent;
    font-family: var(--font-mono);
  }

  .prompts-footer-cta {
    text-align: center;
    padding: var(--space-2xl);
  }
  .prompts-footer-cta p {
    max-width: none;
    color: var(--text-secondary);
    margin: 0 0 var(--space-md);
  }
</style>
